---
// Verbatim markup from waterstrip/*.html (scroll progress, header, drawer).
// Behaviour comes from the vendored src/scripts/mockup/main.js, which keys
// off these exact ids and class names — do not rename them.
import { getSingleton } from '../lib/content/cache.ts';

const awards = getSingleton('home_awards');
const path = Astro.url.pathname;

const navLinks = [
  { label: 'الرئيسية', href: '/' },
  { label: 'عن الشريط', href: '/about' },
  { label: 'مجموعات العمل', href: '/technologies' },
  { label: 'الأعضاء', href: '/members' },
  { label: 'الأخبار والفعاليات', href: '/media' },
  { label: 'تواصل معنا', href: '/contact' },
];
---

<div id="scroll-progress"></div>
<header class="site-head" id="siteHead">
  <nav class="navbar">
    <div class="wrap">
      <a aria-label="Water STRIP — شريط شراكات الابتكار المائي" class="brand" href="/"><img alt="Water STRIP — شريط شراكات الابتكار المائي" src="/img/logo-waterstrip-white.svg" /></a>
      <div class="nav-actions">
        <a class="btn-pill btn-pill--solid" href="/register-interest"><span>سجّل اهتمامك</span></a>
        <button aria-controls="drawer" aria-expanded="false" aria-label="القائمة" class="nav-toggle" id="navToggle" type="button"><svg fill="none" height="26" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="26" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg></button>
      </div>
    </div>
  </nav>
</header>
<div aria-hidden="true" class="drawer" id="drawer">
  <button aria-label="إغلاق" class="drawer__close" id="drawerClose" type="button">×</button>
  <nav class="drawer__nav">
    {navLinks.slice(0, 4).map((link) => (
      <a class:list={[link.href === path && 'is-current']} href={link.href}>{link.label}</a>
    ))}
    {!awards.hidden && (
      <a aria-disabled="true" class="" href="/#awards" tabindex="-1"><span>الجوائز والتكريم</span></a>
    )}
    {navLinks.slice(4).map((link) => (
      <a class:list={[link.href === path && 'is-current']} href={link.href}>{link.label}</a>
    ))}
  </nav>
  <div class="drawer-cta"><a class="is-solid" href="/register-interest">سجّل اهتمامك</a></div>
</div>
