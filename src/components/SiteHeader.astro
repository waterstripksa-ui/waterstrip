---
// The public header, ported from waterstrip/login.html. This is the solid
// inner-page variant; the mobile drawer and nav links need main.js ported and
// are deliberately left out for now.
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label="Water STRIP — شريط شراكات الابتكار المائي"
    >
      <img
        class="site-header__logo"
        src="/img/logo-waterstrip-white.svg"
        alt="Water STRIP — شريط شراكات الابتكار المائي"
        width="180"
        height="42"
      />
    </a>

    <div class="site-header__actions">
      {/* TODO: /register-interest does not exist until that page is ported. */}
      <a class="button button--pill button--pill-solid" href="#">
        <span>سجّل اهتمامك</span>
      </a>
    </div>
  </div>
</header>
