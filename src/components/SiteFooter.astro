---
// Verbatim markup from waterstrip/*.html. The mobile accordion and back-to-top
// come from the vendored src/scripts/mockup/main.js (.foot-col, #toTop).
import { localizePath, type Locale } from '../lib/i18n/locale.ts';
import { ui } from '../lib/i18n/ui.ts';
import { getSingleton } from '../lib/content/cache.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
const href = (path: string) => localizePath(path, locale);
const year = new Date().getFullYear();
const social = getSingleton('footer_social');
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-cols">
      <div class="foot-col">
        <h4>{t.footer.quickLinks}</h4>
        <ul>
          <li><a href={href('/about')}>{t.nav.about}</a></li>
          <li><a href={href('/technologies')}>{t.nav.groups}</a></li>
          <li><a href={href('/members')}>{t.nav.members}</a></li>
          <li><a href={href('/media')}>{t.nav.media}</a></li>
          <li><a href={href('/register-interest')}>{t.nav.register}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t.footer.legal}</h4>
        <ul>
          <li><a href={href('/terms')}>{t.footer.terms}</a></li>
          <li><a href={href('/privacy')}>{t.footer.privacy}</a></li>
          <li><a href={href('/cookies')}>{t.footer.cookies}</a></li>
          <li><a href={href('/accessibility')}>{t.footer.accessibility}</a></li>
          <li><a href={href('/sitemap')}>{t.footer.sitemap}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t.footer.contact}</h4>
        <ul>
          <li><a href="mailto:support@waterstrip.org">support@waterstrip.org</a></li>
          <li><a href={href('/contact')}>{t.footer.contact}</a></li>
          {social.linkedinUrl && (
            <li><a href={social.linkedinUrl} rel="noopener" target="_blank">{t.footer.linkedin}</a></li>
          )}
          {social.xUrl && (
            <li><a href={social.xUrl} rel="noopener" target="_blank">{t.footer.x}</a></li>
          )}
        </ul>
      </div>
      <div class="socials">
        {social.xUrl && (
          <a aria-label={t.footer.x} href={social.xUrl} rel="noopener" target="_blank"><svg fill="currentColor" height="16" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20z"></path></svg></a>
        )}
        {social.linkedinUrl && (
          <a aria-label={t.footer.linkedin} href={social.linkedinUrl} rel="noopener" target="_blank"><svg fill="currentColor" height="16" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path></svg></a>
        )}
        <a aria-label={t.footer.email} href="mailto:support@waterstrip.org"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg></a>
      </div>
    </div>
    <div class="foot-bottom">
      <small>© {year} {t.site.copyright}</small>
      <button aria-label={t.footer.toTop} class="to-top" id="toTop" type="button"><svg fill="none" height="15" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg></button>
      <a aria-label={t.site.brandLabel} class="brand" href={href('/')}><img alt={t.site.brandLabel} src="/img/logo-waterstrip-dark.png" /></a>
    </div>
  </div>
</footer>
