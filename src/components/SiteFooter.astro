---
// Ported from waterstrip/login.html. Links whose routes have not been ported
// yet point at "#" rather than 404ing; they are replaced page by page.
const year = new Date().getFullYear();

const quickLinks = [
  { label: 'عن الشريط', href: '#' },
  { label: 'مجموعات العمل', href: '#' },
  { label: 'الأعضاء', href: '#' },
  { label: 'الأخبار والفعاليات', href: '#' },
  { label: 'سجّل اهتمامك', href: '#' },
];

const legalLinks = [
  { label: 'الشروط والأحكام', href: '#' },
  { label: 'سياسة الخصوصية', href: '#' },
  { label: 'إشعار ملفات الارتباط', href: '#' },
  { label: 'إمكانية الوصول', href: '#' },
  { label: 'خريطة الموقع', href: '#' },
];

const contactLinks = [
  { label: 'support@waterstrip.org', href: 'mailto:support@waterstrip.org', ltr: true },
  { label: 'تواصل معنا', href: '#' },
  { label: 'لينكدإن', href: '#' },
  { label: 'إكس', href: '#' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__cols">
      <div>
        <h4 class="site-footer__heading">روابط سريعة</h4>
        <ul class="site-footer__list">
          {quickLinks.map((link) => (
            <li><a class="site-footer__link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="site-footer__heading">الشؤون النظامية</h4>
        <ul class="site-footer__list">
          {legalLinks.map((link) => (
            <li><a class="site-footer__link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="site-footer__heading">تواصل معنا</h4>
        <ul class="site-footer__list">
          {contactLinks.map((link) => (
            <li>
              <a
                class:list={['site-footer__link', link.ltr && 'u-ltr']}
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="site-footer__socials">
        <a class="site-footer__social" href="#" aria-label="إكس" rel="noopener" target="_blank">
          <svg fill="currentColor" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20z"></path>
          </svg>
        </a>
        <a class="site-footer__social" href="#" aria-label="لينكدإن" rel="noopener" target="_blank">
          <svg fill="currentColor" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path>
          </svg>
        </a>
        <a class="site-footer__social" href="mailto:support@waterstrip.org" aria-label="البريد الإلكتروني">
          <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
            <path d="M3 6.5l9 6.5 9-6.5"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <small class="site-footer__copyright">
        © {year} شريط شراكات الابتكار المائي (Water STRIP).
      </small>
      <button class="site-footer__totop" id="toTop" aria-label="العودة إلى الأعلى" type="button">
        <svg fill="none" stroke="currentColor" stroke-width="1.8" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
      </button>
      <a href="/" aria-label="Water STRIP — شريط شراكات الابتكار المائي">
        <img
          class="site-footer__logo"
          src="/img/logo-waterstrip-white.svg"
          alt="Water STRIP — شريط شراكات الابتكار المائي"
          width="145"
          height="34"
        />
      </a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('toTop')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
