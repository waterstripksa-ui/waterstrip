---
// The closing "join the alliance" banner, verbatim mockup markup. The mockup
// always places it after </main>, so pages render it with slot="after-main".
import { MEMBERSHIP_BANNER_IMG, resolveImage } from '../lib/media-assets.ts';

interface Banner {
  imageId: string | null;
  eyebrowAr: string;
  headingAr: string;
  ledeAr: string;
  ctaLabelAr: string;
  ctaHref: string;
}

interface Props {
  banner: Banner;
}

const { banner } = Astro.props;
---

<section class="about-banner">
  <img alt="" loading="lazy" {...resolveImage(banner.imageId, MEMBERSHIP_BANNER_IMG)} />
  <div class="about-banner__in">
    <p class="eyebrow eyebrow--light">{banner.eyebrowAr}</p>
    <h2>{banner.headingAr}</h2>
    <p class="about-banner__lede">{banner.ledeAr}</p>
    <a class="btn-brand" href={banner.ctaHref}>
      <span>{banner.ctaLabelAr}</span>
      <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
    </a>
  </div>
</section>
