---
// A HubSpot form embedded with HubSpot's v2 script. Submissions go straight to
// HubSpot, never to this server. The form's text comes from HubSpot in English;
// on Arabic pages it is translated and set RTL (see src/lib/i18n/hubspot.ts).
// The success message is ours.
//
// HubSpot renders the form in a same-origin iframe, out of reach of style.css,
// and a form with a HubSpot-side theme ignores the embed's `css` option. So
// onFormReady appends `css` below inside the iframe instead. It restates the
// mockup's .field / .btn-solid values (style.css §28); the `form.hs-form`
// prefix outranks HubSpot's theme selectors. The page's @font-face rules and
// body font are copied in too. If HubSpot renames its classes the form falls
// back to HubSpot's own look and English text.
//
// If the script is blocked (ad blockers, offline) the fallback line points
// people at `email` instead.
import { hubspotFormCopy } from '../lib/i18n/hubspot.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { ui } from '../lib/i18n/ui.ts';

interface Props {
  formId: string;
  /** Shown in place of the form after a successful submission. */
  successMessage: string;
  email: string;
}

const { formId, successMessage, email } = Astro.props;
const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const copy = hubspotFormCopy(locale);

const hubspot = { portalId: '46313188', formId, region: 'na1' };
const targetId = `hs-${formId}`;
const fallbackId = `${targetId}-fallback`;

const css = `
  body { color: #0B2540; }
  form.hs-form fieldset { max-width: none; }
  /* HubSpot floats paired fields left with an LTR-only gutter; flex works both ways. */
  form.hs-form fieldset.form-columns-2 { display: flex; gap: 22px; }
  form.hs-form fieldset.form-columns-2 .hs-form-field { float: none; flex: 1; width: auto; }
  form.hs-form .hs-form-field { margin-bottom: 26px; }
  form.hs-form .hs-form-field > label { display: block; font-size: 12px; font-weight: 400; letter-spacing: .9px; text-transform: uppercase; color: #4A6480; margin-bottom: 9px; }
  form.hs-form .hs-form-required { color: #C0392B; margin-inline-start: 2px; }
  form.hs-form .hs-field-desc { font-family: inherit; font-size: 12px; color: #4A6480; margin: -4px 0 9px; }
  form.hs-form .hs-input { width: 100%; height: auto; font-family: inherit; font-size: 15px; color: #0B2540; background: #fff; border: 1px solid #D4E2EF; border-radius: 0; transition: border-color .3s, box-shadow .3s; }
  /* HubSpot's theme sizes text inputs through a long :not() chain no plain selector outranks. */
  form.hs-form .hs-input { padding: 14px 16px !important; min-height: 52px !important; }
  form.hs-form textarea.hs-input { min-height: 150px !important; resize: vertical; }
  form.hs-form .hs-input:focus { outline: 0; border-color: #154A91; box-shadow: 0 0 0 3px rgba(47,178,220,.18); }
  form.hs-form .hs-input.invalid.error { border-color: #C0392B; }
  form.hs-form .hs-error-msgs { list-style: none; margin: 7px 0 0; padding: 0; }
  form.hs-form .hs-error-msg { font-family: inherit; font-size: 12px; color: #C0392B; }
  form.hs-form .hs-button { height: 52px; line-height: 52px; padding: 0 34px; border: 0; border-radius: 0; color: #fff; font-size: 14px; font-weight: 600; letter-spacing: .5px; transition: background .3s, transform .3s; }
  form.hs-form .hs-button:hover { transform: translateY(-2px); }
  /* The theme sets these per form instance and per :hover/:focus/:active state. */
  form.hs-form label, form.hs-form .hs-button { font-family: inherit !important; }
  form.hs-form .hs-button, form.hs-form .hs-button:focus, form.hs-form .hs-button:active { background: #154A91 !important; }
  form.hs-form .hs-button:hover { background: #103A72 !important; }
  .submitted-message { font-family: inherit; font-size: 15px; color: #154A91; }
  /* As style.css does for [lang="ar"]: tracking breaks Arabic letter joining. */
  html[lang="ar"] form.hs-form .hs-form-field > label, html[lang="ar"] form.hs-form .hs-button { letter-spacing: 0; }
  /* Emails, phone numbers and URLs are typed LTR, still right-aligned in RTL. */
  html[lang="ar"] form.hs-form :is(input[type="email"], .hs-fieldtype-phonenumber input, [class~="hs_0-2/domain"] input) { direction: ltr; text-align: right; }
`;
---

<div class="hs-embed reveal">
  <div dir={copy ? 'rtl' : 'ltr'} id={targetId} lang={copy ? 'ar' : 'en'}></div>
  <p class="hs-embed__fallback" hidden id={fallbackId}>
    {t.common.formFallback} <a href={`mailto:${email}`}>{email}</a>
  </p>
</div>

<script is:inline charset="utf-8" src="https://js.hsforms.net/forms/embed/v2.js"></script>
<script is:inline define:vars={{ hubspot, targetId, fallbackId, css, copy, inlineMessage: successMessage }}>
  // The page's @font-face rules with their URLs made absolute, so the iframe
  // can load the same fonts.
  function fontFaces() {
    const out = [];
    for (const sheet of document.styleSheets) {
      let rules;
      try { rules = sheet.cssRules; } catch { continue; } // cross-origin sheet
      for (const rule of rules) {
        if (!(rule instanceof CSSFontFaceRule)) continue;
        const base = sheet.href || document.baseURI;
        out.push(rule.cssText.replace(/url\((['"]?)([^'")]+)\1\)/g, (_m, _q, url) => `url("${new URL(url, base)}")`));
      }
    }
    return out.join('\n');
  }

  // Idempotent, so a MutationObserver can rerun it whenever HubSpot re-renders.
  function translate(form) {
    const set = (el, text) => {
      if (el && text && el.textContent !== text) el.textContent = text;
    };
    for (const box of form.querySelectorAll('.hs-form-field')) {
      const input = box.querySelector('[name]');
      if (!input) continue;
      // Non-contact properties carry HubSpot's object type, e.g. "0-2/sector".
      const name = input.name.replace(/^\d+-\d+\//, '');
      const field = copy.fields[name] || {};
      const labels = copy.options[name] || {};
      set(box.querySelector(':scope > label > span:first-child'), field.label);
      set(box.querySelector(':scope > .hs-field-desc'), field.description);
      for (const option of box.querySelectorAll('option')) set(option, option.value ? labels[option.value] : copy.choose);
    }
  }

  if (window.hbspt) {
    window.hbspt.forms.create({
      ...hubspot,
      target: `#${targetId}`,
      inlineMessage,
      ...(copy && { locale: copy.locale }),
      onFormReady(wrapped) {
        // A jQuery wrapper or the <form> itself, depending on HubSpot's build.
        const form = wrapped[0] || wrapped;
        const doc = form.ownerDocument;
        const style = doc.createElement('style');
        style.textContent = `${fontFaces()}\n${css}\nbody { font-family: ${getComputedStyle(document.body).fontFamily}; }`;
        doc.head.append(style);
        if (!copy) return;
        doc.documentElement.dir = 'rtl';
        doc.documentElement.lang = 'ar';
        // HubSpot keeps rendering fields after onFormReady, so watch the
        // iframe's body, with the iframe's own MutationObserver.
        const run = () => doc.querySelectorAll('form').forEach(translate);
        run();
        new doc.defaultView.MutationObserver(run).observe(doc.body, { childList: true, subtree: true, characterData: true });
      },
    });
  } else {
    document.getElementById(fallbackId)?.removeAttribute('hidden');
  }
</script>
