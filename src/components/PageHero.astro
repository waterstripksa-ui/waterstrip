---
// Verbatim page-hero markup from the mockup's inner pages. The mockup's crumb
// text varies per page (a bare text node, sometimes with a leading space, or a
// <span>), and inline whitespace is visible, so callers pass the current crumb
// exactly as the mockup writes it.
interface Crumb {
  label: string;
  href?: string;
  /** Wrap the current crumb in <span> (404, forgot-password, working-group). */
  span?: boolean;
}

interface Props {
  title: string;
  lede?: string;
  crumbs?: Crumb[];
  /** `--slim` is forgot-password's band; every other plain page is `--plain`. */
  variant?: 'plain' | 'slim';
  /** Background art (working-group). Renders the bare `page-hero` with an <img>. */
  image?: string;
}

const { title, lede, crumbs = [], variant = 'plain', image } = Astro.props;
---

<section class:list={['page-hero', !image && `page-hero--${variant}`]}>
  {image && <img alt="" src={image} />}
  <div class="wrap">
    {crumbs.length > 0 && (
      <p class="crumbs">{crumbs.map((c, i) => (<>{i > 0 && <span>/</span>}{c.href ? <a href={c.href}>{c.label}</a> : c.span ? <span>{c.label}</span> : c.label}</>))}</p>
    )}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>
