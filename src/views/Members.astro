---
// Markup is waterstrip/members.html verbatim (hardcoded cards there; rendered
// from the member table here, editable at /admin/members). The a–f accent
// modifier cycles by list position, exactly as the mockup's cards do.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { listMembers, getSingleton } from '../lib/content/cache.ts';
import { resolveImage, PLACEHOLDER_IMG } from '../lib/media-assets.ts';
import { accentFor } from '../lib/member-visuals.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const members = listMembers();
const banner = getSingleton('members_banner');
---

<Layout title={t.members.title} description={t.members.description}>
  <PageHero
    title={t.members.title}
    lede={t.members.lede}
    crumbs={[{ label: t.nav.home, href: L.href('/') }, { label: ` ${t.members.title}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{t.members.eyebrow}</p>
          <h2 class="h-section">{t.members.heading}</h2>
          <p class="lede">{t.members.intro}</p>
        </div>
      </div>
      <p class="demo-note"><svg fill="none" height="17" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="17" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg><span><b>{t.common.sourceLabel}</b> {t.members.source}</span></p>
      <div class="grid-3" id="memberGrid">{members.map((m, i) => (
        <a class={`mcard member-card member-card--${accentFor(i)} reveal`} href={L.href(`/member/${m.slug}`)}>
          <span class="member-card__logo"><img alt={L.text(m, 'name')} loading="lazy" {...resolveImage(m.logoId, PLACEHOLDER_IMG)} /></span>
          <h3 {...L.attrs(m, 'name')}>{L.text(m, 'name')}</h3>
        </a>
      ))}</div>
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>
