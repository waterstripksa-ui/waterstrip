---
// No waterstrip/*.html counterpart: the mockup has no reports page. Built from
// its own inner-page pieces (.page-hero, .sec-head, .docs/.doc rows). The page
// copy is fixed interface copy in ui.ts (t.reports); the reports themselves are
// the `reports_list` CMS surface. Each report carries an Arabic and an English
// link list, and the page shows only the list for its own language — no fallback.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const banner = getSingleton('legal_banner');
const { items: reports } = getSingleton('reports_list');

/** The host shown beside each link, so a reader knows where it leads. */
function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}
---

<Layout title={t.reports.title} description={t.reports.description}>
  <PageHero
    title={t.reports.title}
    lede={t.reports.lede}
    crumbs={[{ label: t.nav.home, href: L.href('/') }, { label: ` ${t.reports.title}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{t.reports.eyebrow}</p>
          <h2 class="h-section">{t.reports.heading}</h2>
          <p class="lede">{t.reports.intro}</p>
        </div>
      </div>
      {reports.length === 0 && <p class="lede reveal">{t.reports.empty}</p>}
      {reports.map((report) => {
        const links = locale === 'en' ? report.linksEn : report.linksAr;
        return (
          <div class="docs reveal">
            <h3 {...L.attrs(report, 'title')}>{L.text(report, 'title')}</h3>
            <p class="docs__desc" {...L.attrs(report, 'description')}>{L.text(report, 'description')}</p>
            {links.map((link) => (
              <div class="doc"><div class="doc__row"><a href={link.url} rel="noopener" target="_blank" title={t.reports.external}>{link.label}</a><span class="doc__info">{hostOf(link.url)}</span><a aria-label={`${link.label} — ${t.reports.external}`} class="doc__btn" href={link.url} rel="noopener" target="_blank" tabindex="-1"><svg fill="none" height="18" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="18" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg></a></div></div>
            ))}
          </div>
        );
      })}
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>
