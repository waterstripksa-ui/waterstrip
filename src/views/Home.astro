---
// Markup is waterstrip/index-v2.html verbatim (the Discover section's tile cards sit in
// their own ribbon after Challenges; both halves are one CMS singleton); only the copy, imagery and links are
// swapped for CMS content (editable at /admin/home). An image slot with no upload
// shows its placeholder artwork (src/lib/home-assets.ts). Behaviour (hero
// autoplay, partner marquee, reveals) is the vendored main.js; the corridor map
// and value-chain diagram are src/scripts/corridor-map.js and vchain.js.
// Copy is picked per locale (src/lib/i18n/pick.ts); English falls back to Arabic.
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { discoverTileImages, heroSlideImages, WORKING_GROUPS_IMG } from '../lib/home-assets.ts';
import MembershipBanner from '../components/MembershipBanner.astro';
import PartnersStrip from '../components/PartnersStrip.astro';
import CorridorSection from '../components/CorridorSection.astro';
import ChainIcon from '../components/ChainIcon.astro';
import { STAGE_IDS } from '../lib/content/schemas/home-challenges.ts';
import { imageFor, resolveImage } from '../lib/media-assets.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const hero = getSingleton('home_hero');
const discover = getSingleton('home_discover');
const challenges = getSingleton('home_challenges');
const awards = getSingleton('home_awards');
const workingGroups = getSingleton('home_working_groups');
const aboutBanner = getSingleton('home_about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');

const stages = STAGE_IDS.map((id) => ({ id, ...challenges.chain.stages[id] }));
---

<Layout title={t.home.title}>
  <section class="hero" id="hero">
    <div class="hero__stage">
      {hero.panels.map((panel, i) => (
        <div class:list={['hero__slide', i === 0 && 'is-active']} data-slide={i}>
          <img alt="" {...resolveImage(panel.imageId, imageFor(heroSlideImages, panel.id))} />
        </div>
      ))}
      <div class="hero__scrim"></div>
      <div class="wrap hero__copy">
        {hero.panels.map((panel, i) => (
          <div class:list={['hero__panel', i === 0 && 'is-active']} data-panel={i}>
            <p class="eyebrow eyebrow--light" {...L.attrs(panel, 'eyebrow')}>{L.text(panel, 'eyebrow')}</p>
            {i === 0
              ? <h1 class="h-display" {...L.attrs(panel, 'heading')}>{L.text(panel, 'heading')}</h1>
              : <h2 class="h-display" {...L.attrs(panel, 'heading')}>{L.text(panel, 'heading')}</h2>}
            <div class="hero__actions">
              <a class="cta-circle cta-circle--light" href={L.href(panel.ctaHref)}>
                <span {...L.attrs(panel, 'ctaLabel')}>{L.text(panel, 'ctaLabel')}</span>
                <span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__tabs">
      <div class="wrap">
        {hero.panels.map((panel, i) => (
          <button class:list={['hero-tab', i === 0 && 'is-active']} data-tab={i} type="button"><span {...L.attrs(panel, 'eyebrow')}>{L.text(panel, 'eyebrow')}</span><i></i></button>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey discover">
    <div class="wrap">
      <div class="discover__intro reveal">
        <p class="eyebrow" {...L.attrs(discover, 'eyebrow')}>{L.text(discover, 'eyebrow')}</p>
        <h2 class="h-intro" {...L.attrs(discover, 'heading')}>{L.text(discover, 'heading')}</h2>
      </div>
    </div>
  </section>

  <CorridorSection />

  <section class="ribbon ribbon--grey bizgroup" id="bizgroup">
    <div class="wrap">
      <div class="bizgroup__card reveal">
        <div class="bizgroup__copy">
          <h2 class="bizgroup__title" {...L.attrs(workingGroups, 'title')}>{L.text(workingGroups, 'title')}</h2>
          <p class="bizgroup__lede" {...L.attrs(workingGroups, 'lede')}>{L.text(workingGroups, 'lede')}</p>
          <p class="bizgroup__text" {...L.attrs(workingGroups, 'text')}>{L.text(workingGroups, 'text')}</p>
          <a class="btn-brand" href={L.href(workingGroups.ctaHref)}>
            <span {...L.attrs(workingGroups, 'ctaLabel')}>{L.text(workingGroups, 'ctaLabel')}</span>
            <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <div class="bizgroup__media">
          <img alt={L.text(workingGroups, 'imageAlt')} height="1400" loading="lazy" width="1400" {...resolveImage(workingGroups.imageId, WORKING_GROUPS_IMG)} />
        </div>
      </div>
    </div>
  </section>

  <section class="ribbon challenges" id="challenges">
    <div class="wrap">
      <div class="bizgroup__card vchain__card reveal">
        <div class="bizgroup__copy">
          <h2 class="bizgroup__title" {...L.attrs(challenges, 'title')}>{L.text(challenges, 'title')}</h2>
          <p class="bizgroup__lede" {...L.attrs(challenges, 'lede')}>{L.text(challenges, 'lede')}</p>
          <p class="bizgroup__text" {...L.attrs(challenges, 'text')}>{L.text(challenges, 'text')}</p>
          <a class="btn-brand btn-brand--lg" href={L.href(challenges.ctaHref)}>
            <span {...L.attrs(challenges, 'ctaLabel')}>{L.text(challenges, 'ctaLabel')}</span>
            <svg fill="none" height="16" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <div class="vchain-col">
          <div class="vchain-frame" id="vchainFrame">
            <div class="vchain" id="vchainFig" role="img" aria-label={t.chain.figureLabel(stages.map((stage) => L.text(stage, 'name')))}>
              {stages.map((stage, i) => (
                <div class={`vchain__head s${i + 1}`}>
                  <ChainIcon stage={stage.id} />
                  <span {...L.attrs(stage, 'name')}>{L.text(stage, 'name')}</span>
                </div>
              ))}
              <p class="vchain__band" {...L.attrs(challenges.chain, 'band')}>{L.text(challenges.chain, 'band')}</p>
              {stages.map((stage, i) => (
                <div class={`vchain__col s${i + 1}`}>
                  {stage.items.map((item) => (
                    <span class="vchain__item" {...L.attrs(item, 'text')}>{L.text(item, 'text')}</span>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="vchain__foot">
            <button class="vchain__zoom" id="vchainZoom" type="button">
              <svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.4 15.4 20 20M10.5 7.8v5.4M7.8 10.5h5.4"></path></svg>
              <span>{t.chain.zoom}</span>
            </button>
            <p class="vchain__src" {...L.attrs(challenges.chain, 'source')}>{L.text(challenges.chain, 'source')}</p>
          </div>
        </div>
      </div>
      <div class="vcbox" id="vchainBox" hidden>
        <button aria-label={t.common.close} class="vcbox__close" id="vchainClose" type="button">
          <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-width="1.9" viewBox="0 0 24 24" width="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
        <div class="vcbox__scroll"></div>
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey discover discover--tiles">
    <div class="wrap">
      <div class="card-row bleed reveal">
        {discover.tiles.map((tile) => (
          <a class="tile" href={L.href(tile.href)}>
            <img alt="" {...resolveImage(tile.imageId, imageFor(discoverTileImages, tile.id))} />
            <div class="tile__txt">
              <p class="eyebrow eyebrow--light" {...L.attrs(tile, 'eyebrow')}>{L.text(tile, 'eyebrow')}</p>
              <h3 {...L.attrs(tile, 'heading')}>{L.text(tile, 'heading')}</h3>
            </div>
            <span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {!awards.hidden && (
    <section class="ribbon awards" id="awards">
      <div class="wrap">
        <div class="awards__panel reveal">
          <div class="awards__head">
            <p class="eyebrow eyebrow--light" {...L.attrs(awards, 'eyebrow')}>{L.text(awards, 'eyebrow')}</p>
            <h2 class="h-section" {...L.attrs(awards, 'heading')}>{L.text(awards, 'heading')}</h2>
            <p class="lede" {...L.attrs(awards, 'lede')}>{L.text(awards, 'lede')}</p>
            <a class="btn-brand" href={L.href(awards.ctaHref)}>
              <span {...L.attrs(awards, 'ctaLabel')}>{L.text(awards, 'ctaLabel')}</span>
              <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <ol class="awards__cats">
            {awards.items.map((a, i) => (
              <li class="award">
                <span aria-hidden="true" class="award__no">{ordinal(i)}</span>
                <h3 {...L.attrs(a, 'title')}>{L.text(a, 'title')}</h3>
                <p {...L.attrs(a, 'body')}>{L.text(a, 'body')}</p>
                <i class="award__rule"></i>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <Fragment slot="after-main">
    <PartnersStrip />

    <MembershipBanner banner={aboutBanner} />
  </Fragment>
</Layout>

<script>
  import '../scripts/vchain.js';
</script>
