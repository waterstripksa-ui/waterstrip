---
// Markup is waterstrip/index.html verbatim; only the copy, imagery and links are
// swapped for CMS content (editable at /admin/home). An image slot with no upload
// shows its placeholder artwork (src/lib/home-assets.ts). Behaviour (hero
// autoplay, challenges slider, partner marquee, reveals) is the vendored main.js.
// Copy is picked per locale (src/lib/i18n/pick.ts); English falls back to Arabic.
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { challengeImages, discoverTileImages, heroSlideImages, partnerLogos } from '../lib/home-assets.ts';
import MembershipBanner from '../components/MembershipBanner.astro';
import { imageFor, resolveImage } from '../lib/media-assets.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const hero = getSingleton('home_hero');
const discover = getSingleton('home_discover');
const challenges = getSingleton('home_challenges');
const awards = getSingleton('home_awards');
const map = getSingleton('home_map');
const partners = getSingleton('home_partners');
const aboutBanner = getSingleton('home_about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');

/**
 * Where the map draws a hub's numbered dot. Real-world geometry, not content —
 * a hub's *position in the list* (not anything stored on it) picks its slot, the
 * same way its ordinal is derived. Only the first twelve hubs get a dot; the
 * schema caps the list at twelve for exactly this reason.
 */
const MAP_HUB_SLOTS: ReadonlyArray<{ clusterId: 'rabigh' | 'kaec' | 'thuwal'; cx: number; cy: number }> = [
  { clusterId: 'thuwal', cx: 120, cy: 264 },
  { clusterId: 'thuwal', cx: 98, cy: 278 },
  { clusterId: 'kaec', cx: 120, cy: 168 },
  { clusterId: 'rabigh', cx: 120, cy: 72 },
  { clusterId: 'rabigh', cx: 120, cy: 100 },
  { clusterId: 'kaec', cx: 120, cy: 194 },
  { clusterId: 'thuwal', cx: 120, cy: 292 },
  { clusterId: 'rabigh', cx: 98, cy: 86 },
  { clusterId: 'rabigh', cx: 98, cy: 58 },
  { clusterId: 'kaec', cx: 98, cy: 142 },
  { clusterId: 'kaec', cx: 98, cy: 220 },
  { clusterId: 'thuwal', cx: 98, cy: 250 },
];

/** The four fixed points the corridor runs through, north to south. */
const MAP_CLUSTERS: ReadonlyArray<{
  id: 'rabigh' | 'kaec' | 'thuwal' | 'jeddah';
  cy: number;
  color: string;
  pulseDelay: number | null;
}> = [
  { id: 'rabigh', cy: 86, color: '#2FB2DC', pulseDelay: 0 },
  { id: 'kaec', cy: 180, color: '#2B8CCC', pulseDelay: 0.7 },
  { id: 'thuwal', cy: 278, color: '#1A77BC', pulseDelay: 1.4 },
  { id: 'jeddah', cy: 392, color: '#154A91', pulseDelay: null },
];
---

<Layout title={t.home.title}>
  <section class="hero" id="hero">
    <div class="hero__stage">
      {hero.panels.map((panel, i) => (
        <div class:list={['hero__slide', i === 0 && 'is-active']} data-slide={i}>
          <img alt="" {...resolveImage(panel.imageId, imageFor(heroSlideImages, panel.id))} />
        </div>
      ))}
      <div class="hero__scrim"></div>
      <div class="wrap hero__copy">
        {hero.panels.map((panel, i) => (
          <div class:list={['hero__panel', i === 0 && 'is-active']} data-panel={i}>
            <p class="eyebrow eyebrow--light" {...L.attrs(panel, 'eyebrow')}>{L.text(panel, 'eyebrow')}</p>
            {i === 0
              ? <h1 class="h-display" {...L.attrs(panel, 'heading')}>{L.text(panel, 'heading')}</h1>
              : <h2 class="h-display" {...L.attrs(panel, 'heading')}>{L.text(panel, 'heading')}</h2>}
            <div class="hero__actions">
              <a class="cta-circle cta-circle--light" href={L.href(panel.ctaHref)}>
                <span {...L.attrs(panel, 'ctaLabel')}>{L.text(panel, 'ctaLabel')}</span>
                <span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__tabs">
      <div class="wrap">
        {hero.panels.map((panel, i) => (
          <button class:list={['hero-tab', i === 0 && 'is-active']} data-tab={i} type="button"><span {...L.attrs(panel, 'eyebrow')}>{L.text(panel, 'eyebrow')}</span><i></i></button>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey discover">
    <div class="wrap">
      <div class="discover__intro reveal">
        <p class="eyebrow" {...L.attrs(discover, 'eyebrow')}>{L.text(discover, 'eyebrow')}</p>
        <h2 class="h-intro" {...L.attrs(discover, 'heading')}>{L.text(discover, 'heading')}</h2>
      </div>
      <div class="card-row bleed reveal" style="margin-top:66px">
        {discover.tiles.map((tile) => (
          <a class="tile" href={L.href(tile.href)}>
            <img alt="" {...resolveImage(tile.imageId, imageFor(discoverTileImages, tile.id))} />
            <div class="tile__txt">
              <p class="eyebrow eyebrow--light" {...L.attrs(tile, 'eyebrow')}>{L.text(tile, 'eyebrow')}</p>
              <h3 {...L.attrs(tile, 'heading')}>{L.text(tile, 'heading')}</h3>
            </div>
            <span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon believe challenges" id="challenges">
    <div class="wrap">
      <div class="believe__intro reveal">
        <p class="eyebrow" {...L.attrs(challenges, 'eyebrow')}>{L.text(challenges, 'eyebrow')}</p>
        <h2 class="h-intro" {...L.attrs(challenges, 'heading')}>{L.text(challenges, 'heading')}</h2>
        <div class="slider-nav" id="believeNav">
          <button aria-label={t.common.prev} class="slider-nav__btn" data-dir="prev" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M19 12H6M13 6l-6 6 6 6"></path></svg></button>
          <button aria-label={t.common.next} class="slider-nav__btn" data-dir="next" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
        </div>
      </div>
      <div class="slider bleed reveal" id="believeSlider" role="group" style="margin-top:64px" tabindex="0">
        <div class="slider__track">
          {challenges.items.map((c) => (
            <article class="slide">
              <figure><img alt={L.text(c, 'label')} {...resolveImage(c.imageId, imageFor(challengeImages, c.id))} /></figure>
              <h4 {...L.attrs(c, 'label')}>{L.text(c, 'label')}</h4>
            </article>
          ))}
        </div>
      </div>
      <div class="scrollbar" id="believeBar"><i></i></div>
    </div>
  </section>

  <section class="ribbon map" id="map">
    <div class="wrap">
      <div class="map__panel">
        <div class="map__head reveal">
          <p class="eyebrow eyebrow--light" {...L.attrs(map, 'eyebrow')}>{L.text(map, 'eyebrow')}</p>
          <h2 class="h-section" {...L.attrs(map, 'heading')}>{L.text(map, 'heading')}</h2>
          <p class="lede" {...L.attrs(map, 'lede')}>{L.text(map, 'lede')}</p>
        </div>
        <div class="map__grid">
          <div class="map__viz reveal">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 420 470">
              <defs>
                <linearGradient id="mapSea" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color="#154A91" stop-opacity=".45" />
                  <stop offset="1" stop-color="#61CBF1" stop-opacity=".08" />
                </linearGradient>
              </defs>
              <rect fill="url(#mapSea)" height="470" width="150" x="0" y="0" />
              <text class="map__svg-sea" transform="rotate(-90 34 240)" x="34" y="240">{t.common.redSea}</text>
              <path
                d="M150 0 Q135 60 152 120 Q168 180 150 240 Q134 300 154 360 Q170 420 150 470"
                fill="none"
                stroke="rgba(43,140,204,.5)"
                stroke-width="1.5"
              />
              <rect
                fill="rgba(47,178,220,.10)"
                height="384"
                rx="18"
                stroke="rgba(47,178,220,.35)"
                stroke-width="1"
                width="36"
                x="138"
                y="46"
              />
              <line stroke="rgba(47,178,220,.5)" stroke-dasharray="2 5" stroke-width="1.5" x1="156" x2="156" y1="70" y2="406" />

              {MAP_CLUSTERS.map((c) => (
                <g>
                  <circle cx="156" cy={c.cy} fill={c.color} r="7" />
                  {c.pulseDelay !== null && (
                    <circle cx="156" cy={c.cy} fill="none" r="7" stroke={c.color} stroke-width="1.5">
                      <animate attributeName="r" begin={`${c.pulseDelay}s`} dur="3s" repeatCount="indefinite" values="7;24;7" />
                      <animate attributeName="opacity" begin={`${c.pulseDelay}s`} dur="3s" repeatCount="indefinite" values=".9;0;.9" />
                    </circle>
                  )}
                  <text class="map__svg-name" x="176" y={c.cy - 4}>{L.text(map.clusters[c.id], 'name')}</text>
                  <text class="map__svg-tag" x="176" y={c.cy + 12}>{L.text(map.clusters[c.id], 'tagline')}</text>
                </g>
              ))}

              {map.hubs.map((_, i) => {
                const slot = MAP_HUB_SLOTS[i];
                if (!slot) return null;
                return (
                  <g class:list={['map__svg-dot', `map__svg-dot--${slot.clusterId}`]}>
                    <circle cx={slot.cx} cy={slot.cy} r="9" />
                    <text text-anchor="middle" x={slot.cx} y={slot.cy + 3.5}>{i + 1}</text>
                  </g>
                );
              })}
            </svg>
          </div>
          <ol class="map__legend reveal">
            {map.hubs.map((hub, i) => {
              const slot = MAP_HUB_SLOTS[i];
              return (
                <li class="map__hub">
                  <span aria-hidden="true" class="map__hub-no">{ordinal(i)}</span>
                  <div>
                    <h3 {...L.attrs(hub, 'name')}>{L.text(hub, 'name')}</h3>
                    <p {...L.attrs(hub, 'description')}>{L.text(hub, 'description')}</p>
                  </div>
                  {slot && <span class="map__hub-loc" {...L.attrs(map.clusters[slot.clusterId], 'name')}>{L.text(map.clusters[slot.clusterId], 'name')}</span>}
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </div>
  </section>

  {!awards.hidden && (
    <section class="ribbon awards" id="awards">
      <div class="wrap">
        <div class="awards__panel reveal">
          <div class="awards__head">
            <p class="eyebrow eyebrow--light" {...L.attrs(awards, 'eyebrow')}>{L.text(awards, 'eyebrow')}</p>
            <h2 class="h-section" {...L.attrs(awards, 'heading')}>{L.text(awards, 'heading')}</h2>
            <p class="lede" {...L.attrs(awards, 'lede')}>{L.text(awards, 'lede')}</p>
            <a class="btn-brand" href={L.href(awards.ctaHref)}>
              <span {...L.attrs(awards, 'ctaLabel')}>{L.text(awards, 'ctaLabel')}</span>
              <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <ol class="awards__cats">
            {awards.items.map((a, i) => (
              <li class="award">
                <span aria-hidden="true" class="award__no">{ordinal(i)}</span>
                <h3 {...L.attrs(a, 'title')}>{L.text(a, 'title')}</h3>
                <p {...L.attrs(a, 'body')}>{L.text(a, 'body')}</p>
                <i class="award__rule"></i>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <Fragment slot="after-main">
    <section aria-label={L.text(partners, 'label')} class="partners">
      <div class="wrap">
        <p class="partners__label" {...L.attrs(partners, 'label')}>{L.text(partners, 'label')}</p>
        <div class="partners__viewport">
          <div class="partners__track">
            {/* Not lazy (unlike the mockup): the marquee moves logos into view by
                transform, which does not reliably trigger lazy loading. */}
            {partners.items.map((partner) => (
              <a class="partner" href={L.href(partner.href)} title={L.text(partner, 'name')}><img alt={L.text(partner, 'name')} {...resolveImage(partner.logoId, imageFor(partnerLogos, partner.id))} /></a>
            ))}
          </div>
        </div>
        <p class="partners__note" {...L.attrs(partners, 'note')}>{L.text(partners, 'note')}</p>
      </div>
    </section>

    <MembershipBanner banner={aboutBanner} />
  </Fragment>
</Layout>
