---
// Markup is waterstrip/register-interest.html verbatim, except the form: the
// mockup's own form had no backend, so it is replaced by HubSpot's embedded
// form (submissions go straight to HubSpot, not to this server). Hero and aside
// copy come from the content cache (/admin/register-interest).
// Like the mockup, this page has no closing membership banner.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const hero = getSingleton('register_hero');
const info = getSingleton('register_info');

// HubSpot form "Join Us". Its labels are HubSpot's (English) on both locales.
const hubspot = { portalId: '46313188', formId: '810ee0b8-f9a6-4443-a3e7-6fcbf2d0075f', region: 'na1' };

// HubSpot renders the form in a same-origin iframe, out of reach of style.css,
// and the form's HubSpot-side theme makes it ignore the embed's `css` option.
// So onFormReady appends these rules inside the iframe instead. They restate
// the mockup's .field / .btn-solid values (style.css §28); the `form.hs-form`
// prefix outranks HubSpot's theme selectors. If HubSpot renames its classes the
// form simply falls back to HubSpot's own look.
const hubspotCss = `
  body { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; color: #0B2540; }
  form.hs-form fieldset { max-width: none; }
  form.hs-form .hs-form-field { margin-bottom: 26px; }
  form.hs-form .hs-form-field > label { display: block; font-family: inherit; font-size: 12px; font-weight: 400; letter-spacing: .9px; text-transform: uppercase; color: #4A6480; margin-bottom: 9px; }
  form.hs-form .hs-form-required { color: #C0392B; margin-inline-start: 2px; }
  form.hs-form .hs-field-desc { font-family: inherit; font-size: 12px; color: #4A6480; margin: -4px 0 9px; }
  form.hs-form .hs-input { width: 100%; height: auto; font-family: inherit; font-size: 15px; color: #0B2540; background: #fff; border: 1px solid #D4E2EF; border-radius: 0; transition: border-color .3s, box-shadow .3s; }
  /* HubSpot's theme sizes text inputs through a long :not() chain no plain selector outranks. */
  form.hs-form .hs-input { padding: 14px 16px !important; min-height: 52px !important; }
  form.hs-form .hs-input:focus { outline: 0; border-color: #154A91; box-shadow: 0 0 0 3px rgba(47,178,220,.18); }
  form.hs-form .hs-input.invalid.error { border-color: #C0392B; }
  form.hs-form .hs-error-msgs { list-style: none; margin: 7px 0 0; padding: 0; }
  form.hs-form .hs-error-msg { font-family: inherit; font-size: 12px; color: #C0392B; }
  form.hs-form .hs-button { height: 52px; line-height: 52px; padding: 0 34px; border: 0; border-radius: 0; background: #154A91; color: #fff; font-family: inherit; font-size: 14px; font-weight: 600; letter-spacing: .5px; transition: background .3s, transform .3s; }
  form.hs-form .hs-button:hover { background: #103A72; transform: translateY(-2px); }
  .submitted-message { font-family: inherit; font-size: 15px; color: #154A91; }
`;
---

<Layout title={L.text(hero, 'title')} description={L.text(hero, 'lede')}>
  <PageHero
    title={L.text(hero, 'title')}
    titleAttrs={L.attrs(hero, 'title')}
    lede={L.text(hero, 'lede')}
    ledeAttrs={L.attrs(hero, 'lede')}
    crumbs={[{ label: t.nav.home, href: L.href('/') }, { label: ` ${L.text(hero, 'title')}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="form-shell">
        <div class="hs-embed reveal">
          <div dir="ltr" id="interestForm" lang="en"></div>
          <p class="hs-embed__fallback" hidden id="riFallback">
            {t.register.embedFallback} <a href={`mailto:${info.supportEmail}`}>{info.supportEmail}</a>
          </p>
        </div>
        <aside class="aside-card reveal">
          <h3 {...L.attrs(info, 'heading')}>{L.text(info, 'heading')}</h3>
          <p class="aside-card__lede" {...L.attrs(info, 'lede')}>{L.text(info, 'lede')}</p>
          <ol class="aside-steps">
            {info.steps.map((step, i) => (
              <li>
                <span class="aside-steps__no">{i + 1}</span>
                <span><b {...L.attrs(step, 'title')}>{L.text(step, 'title')}</b><span class="aside-steps__txt" {...L.attrs(step, 'body')}>{L.text(step, 'body')}</span></span>
              </li>
            ))}
          </ol>
          <div class="aside-card__social">
            <p {...L.attrs(info, 'questionLabel')}>{L.text(info, 'questionLabel')}</p>
            <a class="aside-card__mail" href={`mailto:${info.supportEmail}`}>
              <svg fill="none" height="15" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="15" aria-hidden="true"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
              <span>{info.supportEmail}</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline charset="utf-8" src="https://js.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ hubspot, css: hubspotCss, inlineMessage: t.register.success }}>
    // Blocked by an ad blocker or offline: point people at the support address instead.
    if (window.hbspt) {
      window.hbspt.forms.create({
        ...hubspot,
        target: '#interestForm',
        inlineMessage,
        onFormReady(form) {
          // A jQuery wrapper or the <form> itself, depending on HubSpot's build.
          const doc = (form[0] || form).ownerDocument;
          const style = doc.createElement('style');
          style.textContent = css;
          doc.head.append(style);
        },
      });
    } else {
      document.getElementById('riFallback')?.removeAttribute('hidden');
    }
  </script>
</Layout>
