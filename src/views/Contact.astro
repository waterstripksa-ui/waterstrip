---
// Markup is waterstrip/contact.html verbatim, except the form: the mockup's own
// form had no backend, so it is replaced by HubSpot's "Contact" form (see
// HubSpotForm). Hero and aside copy come from the content cache (/admin/contact).
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const hero = getSingleton('contact_hero');
const info = getSingleton('contact_info');
const banner = getSingleton('contact_banner');
---

<Layout title={L.text(hero, 'title')} description={L.text(hero, 'lede')}>
  <PageHero
    title={L.text(hero, 'title')}
    titleAttrs={L.attrs(hero, 'title')}
    lede={L.text(hero, 'lede')}
    ledeAttrs={L.attrs(hero, 'lede')}
    crumbs={[{ label: t.nav.home, href: L.href('/') }, { label: ` ${L.text(hero, 'title')}` }]}
  />

  <section class="ribbon" id="contactMain">
    <div class="wrap">
      <div class="form-shell contact-page">
        <HubSpotForm email={info.supportEmail} formId="810ee0b8-f9a6-4443-a3e7-6fcbf2d0075f" successMessage={t.contact.success} />
        <aside class="aside-card reveal">
          <h3 {...L.attrs(info, 'heading')}>{L.text(info, 'heading')}</h3>
          <p class="aside-card__lede" {...L.attrs(info, 'lede')}>{L.text(info, 'lede')}</p>
          <ul class="aside-list">
            <li>
              <span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg></span>
              <span><b {...L.attrs(info, 'supportLabel')}>{L.text(info, 'supportLabel')}</b><a href={`mailto:${info.supportEmail}`}>{info.supportEmail}</a></span>
            </li>
            <li>
              <span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span>
              <span><b>{t.contact.membership}</b><a href={L.href('/register-interest')} {...L.attrs(info, 'membershipLabel')}>{L.text(info, 'membershipLabel')}</a></span>
            </li>
            <li>
              <span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M4 5h16v14H4z"></path><path d="M8 9h8M8 13h5"></path></svg></span>
              <span><b>{t.contact.mediaInquiries}</b><a href={L.href('/media')} {...L.attrs(info, 'mediaLabel')}>{L.text(info, 'mediaLabel')}</a></span>
            </li>
            <li>
              <span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
              <span><b {...L.attrs(info, 'responseLabel')}>{L.text(info, 'responseLabel')}</b><span class="aside-list__txt" {...L.attrs(info, 'responseText')}>{L.text(info, 'responseText')}</span></span>
            </li>
          </ul>
          <div class="aside-card__social">
            <p>{t.contact.follow}</p>
            <div>
              <a aria-label="LinkedIn" href="#" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path></svg></a>
              <a aria-label="X" href="#" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2z"></path></svg></a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>

