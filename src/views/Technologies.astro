---
// Markup is waterstrip/technologies.html verbatim. The mockup fills #groupGrid
// client-side (main.js §22 from wg-data.js); here the server renders that exact
// card HTML from the working_group table, editable at /admin/technologies.
// Groups have no uploaded photo, so every card takes §22's icon-art branch.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { listWorkingGroups } from '../lib/content/cache.ts';
import { WORKING_GROUP_THEME, iconFor } from '../lib/wg-visuals.ts';
import { localeOfPath } from '../lib/i18n/locale.ts';
import { localizer } from '../lib/i18n/pick.ts';
import { ui } from '../lib/i18n/ui.ts';

const locale = localeOfPath(Astro.url.pathname);
const t = ui(locale);
const L = localizer(locale);

const groups = listWorkingGroups();
---

<Layout title={t.technologies.title} description={t.technologies.description}>
  <PageHero
    title={t.technologies.title}
    lede={t.technologies.lede}
    crumbs={[{ label: t.nav.home, href: L.href('/') }, { label: ` ${t.technologies.title}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{t.technologies.eyebrow}</p>
          <h2 class="h-section">{t.technologies.heading(groups.length)}</h2>
          <p class="lede">{t.technologies.intro}</p>
        </div>
      </div>
      <p class="demo-note"><svg fill="none" height="17" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="17" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg><span><b>{t.common.sourceLabel}</b> {t.technologies.source}</span></p>
      <div class="grid-4" id="groupGrid">{groups.map((g) => (<article class="wg-item"><figure class="wg-item__media wg-item__media--art" style={`background:${WORKING_GROUP_THEME[g.challenge] ?? WORKING_GROUP_THEME.supply}`}><span class="wg-item__no">{g.no}</span><svg class="wg-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconFor(g.slug, g.challenge)}></path></svg></figure><h3 class="wg-item__name" {...L.attrs(g, 'name')}>{L.text(g, 'name')}</h3><p class="wg-item__desc" {...L.attrs(g, 'scope')}>{L.text(g, 'scope')}</p></article>))}</div>
    </div>
  </section>
</Layout>
