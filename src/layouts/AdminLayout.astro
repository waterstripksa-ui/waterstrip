---
import AdminBar from '../components/AdminBar.astro';
import '../styles/main.css';

interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;

// Access is enforced in src/middleware.ts, so a user is guaranteed here.
const user = Astro.locals.user!;

// One item today. Adding a CMS section should be an entry here, never a
// change to the shell's markup.
const sections = [{ label: 'نظرة عامة', href: '/admin' }];

const currentPath = Astro.url.pathname;
---

<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} | لوحة التحكّم`}</title>
    <meta name="theme-color" content="#154A91" />
    {/* The dashboard is never indexable, launched or not. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/img/favicon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap"
    />
  </head>

  <body>
    <a class="u-visually-hidden u-skip-link" href="#main">تخطَّ إلى المحتوى</a>
    <AdminBar name={user.name} role={user.role ?? 'user'} />

    <div class="admin-shell">
      <aside class="admin-shell__nav">
        <nav class="admin-nav" aria-label="أقسام لوحة التحكّم">
          <p class="admin-nav__heading">الأقسام</p>
          <ul class="admin-nav__list">
            {
              sections.map((section) => (
                <li>
                  <a
                    class:list={[
                      'admin-nav__link',
                      currentPath === section.href && 'is-active',
                    ]}
                    href={section.href}
                    aria-current={currentPath === section.href ? 'page' : undefined}
                  >
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <main class="admin-shell__main" id="main">
        <div class="admin-shell__content">
          <h1 class="admin-shell__title">{title}</h1>
          {lede && <p class="admin-shell__lede">{lede}</p>}
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
