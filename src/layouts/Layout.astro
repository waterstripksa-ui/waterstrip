---
// Public pages render the mockup's own markup against its own stylesheet and
// script (vendored as public/mockup/style.css and src/scripts/mockup), so they
// match waterstrip/ by construction. /admin uses AdminLayout and admin.css.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/tajawal/800.css';
import '../styles/mockup/overrides.css';

interface Props {
  title: string;
  description?: string;
  /**
   * The mockup ships every page noindex and the site is not launched, so that
   * stays the default. Flipping it is step 1 of the pre-launch checklist in
   * docs/porting-the-mockup.md.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'شريط شراكات الابتكار المائي — مبادرة سعودية للابتكار في قطاع المياه.',
  noindex = true,
} = Astro.props;

const fullTitle = `${title} | شريط شراكات الابتكار المائي`;
---

<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#154A91" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/img/favicon-192.png" />
    <link rel="apple-touch-icon" href="/img/favicon-512.png" />
    {/* Linked, not imported: see the header of public/mockup/style.css. Astro
        emits bundled CSS (fonts, overrides.css) after this, so overrides win. */}
    <link rel="stylesheet" href="/mockup/style.css" />
    {/* style.css hides .reveal only under .js, so no-JS visitors still see content. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip-link" href="#main">تخطَّ إلى المحتوى</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    {/* The mockup closes <main> before some bands (home partners and about
        banner) and style.css paints `main > section` white, so placement matters. */}
    <slot name="after-main" />
    <SiteFooter />
    {/* Page-specific overlays the mockup places after the footer (media's #lightbox). */}
    <slot name="end" />
  </body>
</html>

<script>
  import '../scripts/mockup/vendor.ts';
  import '../scripts/mockup/main.js';
</script>
