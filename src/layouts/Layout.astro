---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/tajawal/800.css';
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
  /**
   * The mockup ships every page noindex and the site is not launched, so that
   * stays the default. Flipping it is step 1 of the pre-launch checklist in
   * docs/porting-the-mockup.md.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'شريط شراكات الابتكار المائي — مبادرة سعودية للابتكار في قطاع المياه.',
  noindex = true,
} = Astro.props;

const fullTitle = `${title} | شريط شراكات الابتكار المائي`;
---

<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#154A91" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/img/favicon-192.png" />
    <link rel="apple-touch-icon" href="/img/favicon-512.png" />
  </head>

  <body>
    <a class="u-visually-hidden u-skip-link" href="#main">تخطَّ إلى المحتوى</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  const revealed = new Set<Element>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || revealed.has(entry.target)) continue;
        entry.target.classList.add('is-revealed');
        revealed.add(entry.target);
        observer.unobserve(entry.target);
      }
    },
    { threshold: 0.12 },
  );
  document.querySelectorAll('.u-reveal').forEach((el) => observer.observe(el));

  // Failsafe: never leave a section invisible if the observer misses it.
  setTimeout(() => {
    document.querySelectorAll('.u-reveal').forEach((el) => el.classList.add('is-revealed'));
  }, 2500);
</script>
