---
// Ported from waterstrip/working-group.html. The mockup reads its record from
// a `?id=` query param (see docs/porting-the-mockup.md's note on that
// pattern); this port uses a proper dynamic route instead, since the site is
// server-rendered and each group already has a stable slug. No CMS surface
// for this page's own chrome: everything shown comes from the working_group
// row (editable at /admin/technologies) or the technologies_banner singleton.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MembershipBanner from '../../components/MembershipBanner.astro';
import { getWorkingGroup, getSingleton } from '../../lib/content/cache.ts';
import { CHALLENGE_LABELS_AR } from '../../lib/wg-visuals.ts';

const { slug } = Astro.params;
const group = slug ? getWorkingGroup(slug) : null;

if (!group) {
  return Astro.rewrite('/404');
}

const banner = getSingleton('technologies_banner');
const heroImage = '/img/hero/hero-3.svg';
---

<Layout title={group.nameAr} description={group.scopeAr}>
  <PageHero
    image={heroImage}
    title="مجموعة عمل"
    crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مجموعات العمل', href: '/technologies' },
      { label: 'تفاصيل المجموعة' },
    ]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="wg-profile__head u-reveal">
        <span class="wg-profile__no">{group.no}</span>
        <div>
          <p class="eyebrow">مجموعة عمل</p>
          <h2>{group.nameAr}</h2>
        </div>
        {group.statusAr && <span class="wg-profile__status">{group.statusAr}</span>}
      </div>

      <p class="lede wg-profile__scope u-reveal">{group.scopeAr}</p>

      {group.stats.length > 0 && (
        <div class="wg-profile__stats u-reveal">
          {group.stats.map((stat) => (
            <div class="wg-profile__stat">
              <b>{stat.n}</b>
              <span>{stat.labelAr}</span>
            </div>
          ))}
        </div>
      )}

      <div class="wg-profile__facts u-reveal">
        <div class="wg-profile__fact">
          <b>قائد المجموعة</b>
          <span>{group.headAr || 'غير متوفر'}</span>
        </div>
        <div class="wg-profile__fact">
          <b>الجهة القائدة</b>
          <span>{group.leadAr}</span>
        </div>
        <div class="wg-profile__fact wg-profile__fact--wide">
          <b>الجهات المشاركة</b>
          <span>{group.orgsAr}</span>
        </div>
        <div class="wg-profile__fact">
          <b>التحدّي</b>
          <span>{CHALLENGE_LABELS_AR[group.challenge]}</span>
        </div>
      </div>

      {group.recs.length > 0 && (
        <div class="wg-profile__sec u-reveal">
          <h3>التوصيات</h3>
          <ol class="wg-profile__recs">
            {group.recs.map((rec) => (
              <li class="wg-profile__rec">
                <h4>{rec.titleAr}</h4>
                <p>{rec.bodyAr}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {group.noteAr && <p class="wg-profile__note u-reveal">{group.noteAr}</p>}

      <p class="wg-profile__src u-reveal">المصدر: {group.src}</p>

      <div class="wg-profile__nav u-reveal">
        <a class="button button--ghost" href="/technologies">
          <span>كل مجموعات العمل</span>
        </a>
        <a class="button button--solid" href="/register-interest">
          <span>سجّل اهتمامك بالمشاركة</span>
        </a>
      </div>
    </div>
  </section>

  <MembershipBanner banner={banner} />
</Layout>
