---
// Markup is waterstrip/member.html verbatim, filled server-side exactly as
// main.js §14 fills it from WSTRIP_MEMBERS (?id= becomes the [slug] route).
// The cooperation list and contact prompt are the mockup's fixed copy; the
// facts come from the member row (/admin/members), the banner from members_banner.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MembershipBanner from '../../components/MembershipBanner.astro';
import { getMember, getSingleton } from '../../lib/content/cache.ts';
import { resolveImage, PLACEHOLDER_IMG } from '../../lib/media-assets.ts';

const { slug } = Astro.params;
const member = slug ? getMember(slug) : null;

if (!member) {
  return Astro.rewrite('/404');
}

const banner = getSingleton('members_banner');
---

<Layout title={member.nameAr} description={`ملف عضو في شريط شراكات الابتكار المائي: ${member.nameAr}.`}>
  <PageHero
    title="ملف العضو"
    crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'الأعضاء', href: '/members' },
      { label: 'ملف العضو' },
    ]}
  />

  <section class="ribbon">
    <div class="wrap">
      <p class="demo-note"><svg fill="none" height="17" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="17" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg><span><b>المصدر:</b> سجل عضوية شريط شراكات الابتكار المائي. الحقول غير المتوفرة في السجل مكتوبة «غير متوفر».</span></p>
      <div class="member-head reveal">
        <span class="member-card__logo" id="mLogo"><img alt="" {...resolveImage(member.logoId, PLACEHOLDER_IMG)} /></span>
        <div>
          <p class="eyebrow" id="mCat">{member.categoryAr}</p>
          <h2 class="h-section" id="mName" style="margin-top:10px">{member.nameAr}</h2>
        </div>
      </div>
      <div class="facts reveal">
        <div class="fact"><b>الدور في الشريط</b><span id="mRole">{member.roleAr}</span></div>
        <div class="fact"><b>مجال التركيز</b><span id="mSector">{member.sectorAr}</span></div>
        <div class="fact"><b>عضو منذ</b><span id="mSince">{member.sinceAr}</span></div>
      </div>
      <div class="prose reveal" style="margin-top:72px">
        <h2>نبذة</h2>
        <p id="mBio">{member.bioAr}</p>
        <h2>مجالات التعاون</h2>
        <ul>
          <li>التعاون في تطوير تقنيات المياه وتبنّيها ضمن مبادرات الشريط.</li>
          <li>تبادل المعرفة والخبرات مع أعضاء الشريط من داخل المملكة وخارجها.</li>
          <li>المشاركة في مجموعات العمل والفعاليات الدورية للشريط.</li>
        </ul>
      </div>
      <div class="mcontact reveal">
        <div class="mcontact__txt">
          <p class="eyebrow">التواصل</p>
          <h2>تواصل مع هذه الجهة عبر الشريط</h2>
          <p>تُوجَّه الطلبات المتعلقة بهذه الجهة عبر أمانة الشريط، فنحيلها إلى جهة الاتصال المناسبة لديها.</p>
        </div>
        <div class="mcontact__acts">
          <a class="btn-solid" href="/contact">
            <span>افتح نموذج التواصل</span>
            <svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="mcontact__mail" href="mailto:support@waterstrip.org">
            <svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
            <span>support@waterstrip.org</span>
          </a>
        </div>
      </div>
      <div style="margin-top:64px">
        <a class="cta-circle" href="/members"><span>العودة إلى كل الأعضاء</span><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
      </div>
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>
