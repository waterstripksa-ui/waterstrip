---
// Ported from waterstrip/contact.html. Hero and aside copy come from the
// content cache and are editable at /admin/contact. The form itself is fixed
// structure like login.astro's — it has no real backend yet (that is
// deliberately deferred, see docs/porting-the-mockup.md's pre-launch
// checklist item 5), so its submit handling ports the mockup's client-side
// validation faithfully rather than posting anywhere.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { MEMBERSHIP_BANNER_IMG, resolveImage } from '../lib/media-assets.ts';

const hero = getSingleton('contact_hero');
const info = getSingleton('contact_info');
const banner = getSingleton('contact_banner');

const sectors = [
  'تحلية المياه',
  'معالجة مياه الصرف وإعادة الاستخدام',
  'نقل وتخزين المياه',
  'توزيع المياه والشبكات',
  'كفاءة الاستهلاك والترشيد',
  'الري',
  'البيانات والذكاء الاصطناعي',
  'البحث والأوساط الأكاديمية',
  'الجهات الحكومية والسياسات',
  'الاستثمار والتمويل',
  'غير ربحي',
  'أخرى',
];
---

<Layout title={hero.titleAr} description={hero.ledeAr}>
  <PageHero
    title={hero.titleAr}
    lede={hero.ledeAr}
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: hero.titleAr }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="contact-form">
        <form class="form form--panel" id="contact-form" novalidate>
          <div class="form__field">
            <label class="form__label" for="c-name">الاسم الكامل</label>
            <input id="c-name" name="fullName" autocomplete="name" placeholder="مثال: سارة الأحمد" required />
          </div>

          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="c-email">البريد الإلكتروني</label>
              <input id="c-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
            </div>
            <div class="form__field">
              <label class="form__label" for="c-phone">رقم الجوال</label>
              <input id="c-phone" name="mobile" type="tel" inputmode="tel" autocomplete="tel" value="+966" />
              <p class="form__hint">أضف رمز الدولة. مثال: ‎+96659xxxxxxx</p>
            </div>
          </div>

          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="c-company">اسم الجهة أو الشركة</label>
              <input id="c-company" name="company" autocomplete="organization" placeholder="مثال: شركة تقنيات المياه" required />
            </div>
            <div class="form__field">
              <label class="form__label" for="c-sector">القطاع</label>
              <select id="c-sector" name="sector" required>
                <option value="" selected>الرجاء الاختيار</option>
                {sectors.map((sector) => <option value={sector}>{sector}</option>)}
              </select>
            </div>
          </div>

          <div class="form__field">
            <label class="form__label" for="c-country">الدولة</label>
            <select id="c-country" name="country">
              <option value="" selected>الرجاء الاختيار</option>
              {sectors.map((sector) => <option value={sector}>{sector}</option>)}
            </select>
          </div>

          <div class="form__actions">
            <button class="button button--solid" type="submit">
              <span>إرسال</span>
              <svg class="button__icon" fill="none" stroke="currentColor" stroke-width="1.6" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6"></path>
              </svg>
            </button>
            <span class="form__status" id="contact-form-status" hidden>
              <svg fill="none" stroke="currentColor" stroke-width="2" height="18" width="18" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
              <span>تم استلام طلبك. سنتواصل معك قريبًا.</span>
            </span>
          </div>
        </form>

        <aside class="contact-form__aside">
          <h3>{info.headingAr}</h3>
          <p class="contact-form__lede">{info.ledeAr}</p>
          <ul class="contact-form__list">
            <li class="contact-form__item">
              <span class="contact-form__icon">
                <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
                  <path d="M3 6.5l9 6.5 9-6.5"></path>
                </svg>
              </span>
              <span>
                <b class="contact-form__label">{info.supportLabelAr}</b>
                <a class="contact-form__value" href={`mailto:${info.supportEmail}`}>{info.supportEmail}</a>
              </span>
            </li>
            <li class="contact-form__item">
              <span class="contact-form__icon">
                <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </span>
              <span>
                <b class="contact-form__label">العضوية</b>
                <a class="contact-form__value" href="/register-interest">{info.membershipLabelAr}</a>
              </span>
            </li>
            <li class="contact-form__item">
              <span class="contact-form__icon">
                <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5h16v14H4z"></path>
                  <path d="M8 9h8M8 13h5"></path>
                </svg>
              </span>
              <span>
                <b class="contact-form__label">الاستفسارات الإعلامية</b>
                <a class="contact-form__value" href="/media">{info.mediaLabelAr}</a>
              </span>
            </li>
            <li class="contact-form__item">
              <span class="contact-form__icon">
                <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </span>
              <span>
                <b class="contact-form__label">{info.responseLabelAr}</b>
                <span class="contact-form__value">{info.responseTextAr}</span>
              </span>
            </li>
          </ul>
          <div class="contact-form__social">
            <p>تابعنا</p>
            <div class="contact-form__social-links">
              <a href="#" rel="noopener" target="_blank" aria-label="LinkedIn">
                <svg fill="currentColor" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path>
                </svg>
              </a>
              <a href="#" rel="noopener" target="_blank" aria-label="X">
                <svg fill="currentColor" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2z"></path>
                </svg>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="about-banner">
    <img {...resolveImage(banner.imageId, MEMBERSHIP_BANNER_IMG)} alt="" loading="lazy" />
    <div class="about-banner__in">
      <p class="eyebrow eyebrow--light">{banner.eyebrowAr}</p>
      <h2>{banner.headingAr}</h2>
      <p class="about-banner__lede">{banner.ledeAr}</p>
      <a class="button button--brand" href={banner.ctaHref}>
        <span>{banner.ctaLabelAr}</span>
        <svg class="button__icon" fill="none" stroke="currentColor" stroke-width="1.9" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  // Client-side validation + confirmation only — no backend yet, matching the
  // mockup's own behaviour (see docs/porting-the-mockup.md's pre-launch
  // checklist item 5, which defers a real handler to a follow-up).
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((field) => {
      const bad = !field.value.trim();
      field.style.borderColor = bad ? '#C0392B' : '';
      if (bad) ok = false;
    });
    if (!ok) return;
    status?.removeAttribute('hidden');
    form.querySelector('button[type="submit"]')?.setAttribute('disabled', '');
  });

  form?.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    target.style.borderColor = '';
  });
</script>
