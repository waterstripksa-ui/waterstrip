---
// Markup is waterstrip/register-interest.html verbatim. Hero and aside copy
// come from the content cache (/admin/register-interest). No backend yet
// (pre-launch checklist item 5), so the inline script is the mockup's own
// main.js §15 behaviour for #interestForm; the file picker label is main.js §20.
// Like the mockup, this page has no closing membership banner.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton } from '../lib/content/cache.ts';

const hero = getSingleton('register_hero');
const info = getSingleton('register_info');

const entityTypes = ['جهة حكومية', 'مؤسسة أكاديمية', 'شركة من القطاع الخاص', 'منظمة غير ربحية', 'مبتكر فرد'];
const interestAreas = [
  'ندرة الموارد المائية',
  'ارتفاع تكاليف التحلية',
  'ضعف كفاءة معالجة مياه الصرف',
  'تقادم البنية التحتية',
  'تشتّت الجهود والخبرات',
  'أخرى / غير محدد بعد',
];
---

<Layout title={hero.titleAr} description={hero.ledeAr}>
  <PageHero
    title={hero.titleAr}
    lede={hero.ledeAr}
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: ` ${hero.titleAr}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="form-shell">
        <form class="form reveal" id="interestForm" novalidate>
          <div class="row-2">
            <div class="field"><label for="ri-name">الاسم الكامل *</label><input id="ri-name" name="name" required /></div>
            <div class="field"><label for="ri-entity">اسم الجهة *</label><input id="ri-entity" name="entity" required /></div>
          </div>
          <div class="row-2">
            <div class="field"><label for="ri-type">نوع الجهة *</label>
              <select id="ri-type" name="type" required><option value="">اختر…</option>{entityTypes.map((t) => <option>{t}</option>)}</select></div>
            <div class="field"><label for="ri-email">البريد الإلكتروني للعمل *</label><input id="ri-email" name="email" required type="email" /></div>
          </div>
          <div class="row-2">
            <div class="field"><label for="ri-phone">رقم الجوال</label><input id="ri-phone" name="phone" /></div>
            <div class="field"><label for="ri-site">الموقع الإلكتروني</label><input id="ri-site" name="website" placeholder="https://" /></div>
          </div>
          <div class="field"><label for="ri-area">مجال الاهتمام *</label>
            <select id="ri-area" name="area" required><option selected value="">اختر…</option>{interestAreas.map((a) => <option value={a}>{a}</option>)}</select>
            <p class="hint">مرتبط بالتحديات الخمسة التي يعمل عليها الشريط في قطاع المياه.</p></div>
          <div class="field"><label for="ri-msg">لماذا ترغب بالانضمام؟</label><textarea id="ri-msg" name="message"></textarea></div>
          <div class="field">
            <label for="ri-file">ملف الأعمال أو العرض التعريفي</label>
            <p class="hint hint--top">PDF أو PPTX أو DOCX · حتى 10 م.ب · اختياري</p>
            <div class="filepick">
              <input accept=".pdf,.ppt,.pptx,.doc,.docx" id="ri-file" name="portfolio" type="file" />
              <label class="filepick__btn" for="ri-file">اختر ملفًا</label>
              <span class="filepick__name">لم يُختر أي ملف</span>
            </div>
          </div>
          <label class="check"><input required type="checkbox" /><span>أُقرّ بأنني مخوّل بتقديم هذا الطلب نيابةً عن الجهة المذكورة أعلاه، وأوافق على <a href="/terms" style="color:var(--c-link)">الشروط والأحكام</a> و<a href="/privacy" style="color:var(--c-link)">سياسة الخصوصية</a>.</span></label>
          <div class="form-actions">
            <button class="btn-solid" type="submit"><span>إرسال التسجيل</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
            <span class="form-msg" id="riMsg"><svg fill="none" height="15" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg><span>شكرًا لك — تم تسجيل طلبك بنجاح.</span></span>
          </div>
        </form>
        <aside class="aside-card reveal">
          <h3>{info.headingAr}</h3>
          <p class="aside-card__lede">{info.ledeAr}</p>
          <ol class="aside-steps">
            {info.steps.map((step, i) => (
              <li>
                <span class="aside-steps__no">{i + 1}</span>
                <span><b>{step.titleAr}</b><span class="aside-steps__txt">{step.bodyAr}</span></span>
              </li>
            ))}
          </ol>
          <div class="aside-card__social">
            <p>{info.questionLabelAr}</p>
            <a class="aside-card__mail" href={`mailto:${info.supportEmail}`}>
              <svg fill="none" height="15" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="15" aria-hidden="true"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
              <span>{info.supportEmail}</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  // main.js §15 for #interestForm, verbatim in behaviour.
  const form = document.getElementById('interestForm') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((f) => {
      const bad = f instanceof HTMLInputElement && f.type === 'checkbox' ? !f.checked : !f.value.trim();
      f.style.borderColor = bad ? '#C0392B' : '';
      if (bad) ok = false;
    });
    if (!ok) return;
    document.getElementById('riMsg')?.classList.add('is-on');
    form.querySelector('.btn-solid')?.setAttribute('disabled', '');
  });
  form?.addEventListener('input', (e) => {
    (e.target as HTMLElement).style.borderColor = '';
  });
</script>
