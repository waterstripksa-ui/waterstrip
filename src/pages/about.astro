---
// Markup is waterstrip/about.html verbatim (inline styles included); copy and
// imagery come from the content cache, editable at /admin/about. An image slot
// with no upload shows its placeholder artwork (src/lib/about-assets.ts).
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { FOUNDING_STATEMENT_IMG, MISSION_IMG, nationalChallengeImages } from '../lib/about-assets.ts';
import { imageFor, resolveImage } from '../lib/media-assets.ts';

const hero = getSingleton('about_hero');
const mission = getSingleton('about_mission');
const glance = getSingleton('about_glance');
const challenges = getSingleton('about_challenges');
const goals = getSingleton('about_goals');
const founding = getSingleton('about_founding_statement');
const banner = getSingleton('about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title={hero.titleAr}>
  <PageHero
    title={hero.titleAr}
    lede={hero.ledeAr}
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: ` ${hero.titleAr}` }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{mission.eyebrowAr}</p>
          <h2 class="h-section">{mission.headingAr}</h2>
        </div>
      </div>
      <div class="split reveal">
        <div>
          <p style="font-size:17px;line-height:29px;margin-bottom:20px;">{mission.bodyAr1}</p>
          <p style="font-size:17px;line-height:29px;">{mission.bodyAr2}</p>
        </div>
        <figure><img alt="شريط شراكات الابتكار المائي" loading="lazy" {...resolveImage(mission.imageId, MISSION_IMG)} /></figure>
      </div>
    </div>
  </section>

  {!glance.hidden && (
    <section class="ribbon ribbon--grey glance">
      <div class="wrap reveal glance__panel">
        <h2 class="h-section">{glance.headingAr}</h2>
        <div class="stats" style="grid-template-columns:repeat(4,1fr)">
          {glance.stats.map((stat) => (
            <div class="stat"><b data-count={stat.value}>0</b><p>{stat.labelAr}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="ribbon">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{challenges.eyebrowAr}</p>
          <h2 class="h-section">{challenges.headingAr}</h2>
          <p class="lede">{challenges.ledeAr}</p>
        </div>
        <a class="cta-circle" href={challenges.ctaHref}><span>{challenges.ctaLabelAr}</span><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
      </div>
      <div class="grid-3 reveal">
        {challenges.items.map((item) => (
          <article class="tri__card">
            <figure><img alt={item.titleAr} {...resolveImage(item.imageId, imageFor(nationalChallengeImages, item.id))} /></figure>
            <h3>{item.titleAr}</h3><p>{item.bodyAr}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="sec-head__txt">
          <p class="eyebrow">{goals.eyebrowAr}</p>
          <h2 class="h-section">{goals.headingAr}</h2>
          <p class="lede">{goals.ledeAr}</p>
        </div>
      </div>
      <div class="grid-4 reveal">
        {goals.items.map((goal, i) => (
          <div class="fact" style="border-top-width:2px;padding-top:22px">
            <b>{ordinal(i)}</b><h3 style="font-size:20px;font-weight:500;margin:6px 0 12px">{goal.titleAr}</h3>
            <p style="font-size:15px;line-height:25px;color:var(--c-text-soft)">{goal.bodyAr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon">
    <div class="wrap">
      <div class="split reveal">
        <figure><img alt="" {...resolveImage(founding.imageId, FOUNDING_STATEMENT_IMG)} /></figure>
        <div>
          <p class="eyebrow">{founding.eyebrowAr}</p>
          <h3 style="font-family:var(--f-head);font-size:27px;line-height:38px;font-weight:500;margin:16px 0 24px">«{founding.quoteAr}»</h3><p class="eyebrow" style="margin:-8px 0 24px">{founding.attributionAr}</p>
          <a class="cta-circle" href={founding.ctaHref}><span>{founding.ctaLabelAr}</span><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
        </div>
      </div>
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>
