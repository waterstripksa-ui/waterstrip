---
// Ported from waterstrip/about.html. All copy and imagery come from the content
// cache and are editable at /admin/about; an image slot with no upload shows its
// placeholder artwork (src/lib/about-assets.ts). Links to pages that have not
// been ported yet hold "#", matching the convention in SiteHeader/SiteFooter.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { FOUNDING_STATEMENT_IMG, MISSION_IMG, nationalChallengeImages } from '../lib/about-assets.ts';
import { imageFor, resolveImage } from '../lib/media-assets.ts';

const hero = getSingleton('about_hero');
const mission = getSingleton('about_mission');
const glance = getSingleton('about_glance');
const challenges = getSingleton('about_challenges');
const goals = getSingleton('about_goals');
const founding = getSingleton('about_founding_statement');
const banner = getSingleton('about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title={hero.titleAr}>
  <PageHero
    title={hero.titleAr}
    lede={hero.ledeAr}
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: hero.titleAr }]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="section-head u-reveal">
        <div class="section-head__text">
          <p class="eyebrow">{mission.eyebrowAr}</p>
          <h2>{mission.headingAr}</h2>
        </div>
      </div>
      <div class="split u-reveal">
        <div>
          <p class="lede">{mission.bodyAr1}</p>
          <p class="lede">{mission.bodyAr2}</p>
        </div>
        <figure class="split__figure">
          <img {...resolveImage(mission.imageId, MISSION_IMG)} alt="" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  {!glance.hidden && (
    <section class="ribbon ribbon--grey">
      <div class="wrap u-reveal">
        <h2 class="stats__heading">{glance.headingAr}</h2>
        <div class="stats__grid">
          {glance.stats.map((stat) => (
            <div class="stats__item">
              <b class="stats__value">{stat.value}</b>
              <p class="stats__label">{stat.labelAr}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="ribbon">
    <div class="wrap">
      <div class="section-head u-reveal">
        <div class="section-head__text">
          <p class="eyebrow">{challenges.eyebrowAr}</p>
          <h2>{challenges.headingAr}</h2>
          <p class="lede">{challenges.ledeAr}</p>
        </div>
        <a class="cta-circle" href={challenges.ctaHref}>
          <span>{challenges.ctaLabelAr}</span>
          <span class="circ">
            <svg fill="none" stroke="currentColor" stroke-width="1.6" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </a>
      </div>
      <div class="feature-grid u-reveal">
        {challenges.items.map((item) => (
          <article class="feature-grid__item">
            <figure class="feature-grid__figure">
              <img {...resolveImage(item.imageId, imageFor(nationalChallengeImages, item.id))} alt={item.titleAr} />
            </figure>
            <h3 class="feature-grid__title">{item.titleAr}</h3>
            <p class="feature-grid__body">{item.bodyAr}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey">
    <div class="wrap">
      <div class="section-head u-reveal">
        <div class="section-head__text">
          <p class="eyebrow">{goals.eyebrowAr}</p>
          <h2>{goals.headingAr}</h2>
          <p class="lede">{goals.ledeAr}</p>
        </div>
      </div>
      <div class="goal-grid u-reveal">
        {goals.items.map((goal, i) => (
          <div class="goal-grid__item">
            <b class="goal-grid__no">{ordinal(i)}</b>
            <h3 class="goal-grid__title">{goal.titleAr}</h3>
            <p class="goal-grid__body">{goal.bodyAr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon">
    <div class="wrap">
      <div class="split u-reveal">
        <figure class="split__figure">
          <img {...resolveImage(founding.imageId, FOUNDING_STATEMENT_IMG)} alt="" loading="lazy" />
        </figure>
        <div>
          <p class="eyebrow">{founding.eyebrowAr}</p>
          <h3 class="split__quote">«{founding.quoteAr}»</h3>
          <p class="eyebrow split__attribution">{founding.attributionAr}</p>
          <a class="cta-circle" href={founding.ctaHref}>
            <span>{founding.ctaLabelAr}</span>
            <span class="circ">
              <svg fill="none" stroke="currentColor" stroke-width="1.6" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <MembershipBanner banner={banner} />
</Layout>
