---
// Markup is waterstrip/sitemap.html verbatim. Pure site navigation — the same
// routes SiteHeader/SiteFooter carry — so no CMS surface beyond the shared
// legal_banner. Update this list alongside those components, not via /admin.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';

const banner = getSingleton('legal_banner');

const groups = [
  {
    headingAr: 'الرئيسية',
    links: [
      { label: 'الرئيسية', href: '/' },
      { label: 'عن الشريط', href: '/about' },
      { label: 'مجموعات العمل', href: '/technologies' },
      { label: 'الأعضاء', href: '/members' },
      { label: 'الأخبار والفعاليات', href: '/media' },
      { label: 'تواصل معنا', href: '/contact' },
    ],
  },
  {
    headingAr: 'المشاركة',
    links: [
      { label: 'سجّل اهتمامك', href: '/register-interest' },
      { label: 'دليل الأعضاء', href: '/members' },
      { label: 'ملف العضو', href: '/members' },
    ],
  },
  {
    headingAr: 'الأخبار والفعاليات',
    links: [
      { label: 'الأخبار', href: '/media' },
      { label: 'الفعاليات والمعارض', href: '/media' },
    ],
  },
  {
    headingAr: 'الشؤون النظامية',
    links: [
      { label: 'الشروط والأحكام', href: '/terms' },
      { label: 'سياسة الخصوصية', href: '/privacy' },
      { label: 'إشعار ملفات الارتباط', href: '/cookies' },
      { label: 'إمكانية الوصول', href: '/accessibility' },
      { label: 'خريطة الموقع', href: '/sitemap' },
    ],
  },
];
---

<Layout title="خريطة الموقع">
  <PageHero
    title="خريطة الموقع"
    lede="كل صفحات الموقع في مكان واحد."
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: ' خريطة الموقع' }]}
  />

  <section class="ribbon"><div class="wrap"><div class="sitemap reveal">{groups.map((g) => (<div><h3>{g.headingAr}</h3><ul>{g.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}</ul></div>))}</div></div></section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>
