---
// Ported from waterstrip/article.html. The mockup reads its record from a
// `?id=` query param; this port uses a proper dynamic route instead, same
// reasoning as working-group/[slug].astro. No CMS surface for this page's own
// chrome: everything shown comes from the article row (editable at
// /admin/media) or the media_banner singleton.
import Layout from '../../layouts/Layout.astro';
import MembershipBanner from '../../components/MembershipBanner.astro';
import { getArticle, getSingleton } from '../../lib/content/cache.ts';
import { imageFor, resolveImage } from '../../lib/media-assets.ts';
import { articleImages } from '../../lib/article-assets.ts';

const { slug } = Astro.params;
const article = slug ? getArticle(slug) : null;

if (!article) {
  return Astro.rewrite('/404');
}

const banner = getSingleton('media_banner');
const hero = resolveImage(article.imageId, imageFor(articleImages, article.slug));
---

<Layout title={article.titleAr} description={article.ledeAr}>
  <article class="article">
    <header class="article__hero">
      <img src={hero.src} alt="" />
      <div class="article__scrim"></div>
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="مسار التنقل">
          <a class="breadcrumbs__link" href="/">الرئيسية</a>
          <span class="breadcrumbs__sep" aria-hidden="true">/</span>
          <a class="breadcrumbs__link" href="/media">الأخبار والفعاليات</a>
          <span class="breadcrumbs__sep" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{article.kindAr}</span>
        </nav>
        <h1>{article.titleAr}</h1>
        <p class="article__meta">
          <span>{article.dateAr}</span>
          <i></i>
          <span>{article.readAr}</span>
        </p>
      </div>
    </header>

    <div class="wrap">
      <div class="article__body u-reveal">
        <p class="article__lede">{article.ledeAr}</p>

        {article.blocks.length > 0 && (
          <div class="article__sections">
            {article.blocks.map((b) => (
              <>
                <h2>{b.headingAr}</h2>
                <p>{b.bodyAr}</p>
              </>
            ))}
          </div>
        )}

        {article.quoteAr && (
          <figure class="article__quote">
            <blockquote>{article.quoteAr}</blockquote>
            {article.quoteByAr && <figcaption>{article.quoteByAr}</figcaption>}
          </figure>
        )}

        {article.tagsAr.length > 0 && (
          <div class="article__tags">
            {article.tagsAr.map((tag) => (
              <span class="article__tag">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <div class="article__nav u-reveal">
        <a class="button button--ghost" href="/media">عودة إلى الأخبار والفعاليات</a>
        <a class="button button--solid" href="/register-interest">سجّل اهتمامك</a>
      </div>
    </div>
  </article>

  <MembershipBanner banner={banner} />
</Layout>
