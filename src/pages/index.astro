---
// Ported from waterstrip/index.html. All copy and imagery come from the content
// cache and are editable at /admin/home; an image slot with no upload shows its
// placeholder artwork (src/lib/home-assets.ts). Links to pages that have not been ported yet
// hold "#", matching the convention in SiteHeader/SiteFooter.
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/content/cache.ts';
import {
  ABOUT_BANNER_IMG,
  challengeImages,
  discoverTileImages,
  heroSlideImages,
  imageFor,
  partnerLogos,
  resolveImage,
} from '../lib/home-assets.ts';

const hero = getSingleton('home_hero');
const discover = getSingleton('home_discover');
const challenges = getSingleton('home_challenges');
const awards = getSingleton('home_awards');
const partners = getSingleton('home_partners');
const aboutBanner = getSingleton('home_about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title="الرئيسية">
  <section class="hero" id="hero">
    <div class="hero__stage">
      {hero.panels.map((panel, i) => (
        <div class:list={['hero__slide', i === 0 && 'is-active']} data-slide={i}>
          <img {...resolveImage(panel.imageId, imageFor(heroSlideImages, panel.id))} alt="" />
        </div>
      ))}
      <div class="hero__scrim"></div>
      <div class="wrap hero__copy">
        {hero.panels.map((panel, i) => (
          <div class:list={['hero__panel', i === 0 && 'is-active']} data-panel={i}>
            <p class="eyebrow eyebrow--light">{panel.eyebrowAr}</p>
            {i === 0 ? <h1>{panel.headingAr}</h1> : <h2>{panel.headingAr}</h2>}
            <div class="hero__actions">
              <a class="cta-circle" href={panel.ctaHref}>
                <span>{panel.ctaLabelAr}</span>
                <span class="circ">
                  <svg fill="none" stroke="currentColor" stroke-width="1.6" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6"></path>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__tabs">
      <div class="wrap">
        {hero.panels.map((panel, i) => (
          <button class:list={['hero-tab', i === 0 && 'is-active']} data-tab={i} type="button">
            <span>{panel.eyebrowAr}</span>
            <i></i>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--sunken discover">
    <div class="wrap">
      <div class="discover__intro u-reveal">
        <p class="eyebrow">{discover.eyebrowAr}</p>
        <h2>{discover.headingAr}</h2>
      </div>
      <div class="card-row u-reveal">
        {discover.tiles.map((tile) => (
          <a class="tile" href={tile.href}>
            <img {...resolveImage(tile.imageId, imageFor(discoverTileImages, tile.id))} alt="" />
            <div class="tile__txt">
              <p class="eyebrow eyebrow--light">{tile.eyebrowAr}</p>
              <h3>{tile.headingAr}</h3>
            </div>
            <span class="tile__arrow">
              <svg fill="none" stroke="currentColor" stroke-width="1.8" height="14" width="14" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon challenges" id="challenges">
    <div class="wrap">
      <div class="challenge-slider__intro u-reveal">
        <p class="eyebrow">{challenges.eyebrowAr}</p>
        <h2>{challenges.headingAr}</h2>
        <div class="slider-nav" id="challengeNav">
          <button class="slider-nav__btn" data-dir="prev" type="button" aria-label="السابق">
            <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 12H6M13 6l-6 6 6 6"></path>
            </svg>
          </button>
          <button class="slider-nav__btn" data-dir="next" type="button" aria-label="التالي">
            <svg fill="none" stroke="currentColor" stroke-width="1.7" height="16" width="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="challenge-slider u-reveal" id="challengeSlider" role="group" tabindex="0">
        <div class="challenge-slider__track">
          {challenges.items.map((c) => (
            <article class="challenge-slide">
              <figure>
                <img {...resolveImage(c.imageId, imageFor(challengeImages, c.id))} alt={c.labelAr} />
              </figure>
              <h4>{c.labelAr}</h4>
            </article>
          ))}
        </div>
      </div>
      <div class="challenge-slider__bar" id="challengeBar"><i></i></div>
    </div>
  </section>

  <section class="awards" id="awards">
    <div class="wrap">
      <div class="awards__panel">
        <div class="awards__head">
          <p class="eyebrow eyebrow--light">{awards.eyebrowAr}</p>
          <h2>{awards.headingAr}</h2>
          <p class="lede">{awards.ledeAr}</p>
          <a class="button button--brand" href={awards.ctaHref}>
            <span>{awards.ctaLabelAr}</span>
            <svg class="button__icon" fill="none" stroke="currentColor" stroke-width="1.9" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
        <ol class="awards__cats">
          {awards.items.map((a, i) => (
            <li class="award">
              <span class="award__no" aria-hidden="true">{ordinal(i)}</span>
              <h3>{a.titleAr}</h3>
              <p>{a.bodyAr}</p>
              <i class="award__rule"></i>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="partners" aria-label={partners.labelAr}>
    <div class="wrap">
      <p class="partners__label">{partners.labelAr}</p>
      <div class="partners__viewport">
        {/* The logos are not lazy: the marquee scrolls every one of them through
            the viewport by transform, which does not trigger lazy loading. */}
        <div class="partners__track" id="partnersTrack">
          {partners.items.map((partner) => (
            <a class="partner" href={partner.href} title={partner.nameAr}>
              <img {...resolveImage(partner.logoId, imageFor(partnerLogos, partner.id))} alt={partner.nameAr} />
            </a>
          ))}
        </div>
      </div>
      <p class="partners__note">{partners.noteAr}</p>
    </div>
  </section>

  <section class="about-banner">
    <img {...resolveImage(aboutBanner.imageId, ABOUT_BANNER_IMG)} alt="" loading="lazy" />
    <div class="about-banner__in">
      <p class="eyebrow eyebrow--light">{aboutBanner.eyebrowAr}</p>
      <h2>{aboutBanner.headingAr}</h2>
      <p class="about-banner__lede">{aboutBanner.ledeAr}</p>
      <a class="button button--brand" href={aboutBanner.ctaHref}>
        <span>{aboutBanner.ctaLabelAr}</span>
        <svg class="button__icon" fill="none" stroke="currentColor" stroke-width="1.9" height="15" width="15" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  const HERO_DURATION = 8000;
  const heroEl = document.getElementById('hero');
  const slides = Array.from(document.querySelectorAll('.hero__slide'));
  const panels = Array.from(document.querySelectorAll('.hero__panel'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-tab'));
  let heroIndex = 0;
  let heroTimer: ReturnType<typeof setInterval> | null = null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.documentElement.style.setProperty('--hero-dur', `${HERO_DURATION / 1000}s`);

  function goToSlide(i: number) {
    heroIndex = (i + slides.length) % slides.length;
    slides.forEach((s, n) => s.classList.toggle('is-active', n === heroIndex));
    panels.forEach((p, n) => p.classList.toggle('is-active', n === heroIndex));
    tabs.forEach((t, n) => {
      t.classList.toggle('is-active', n === heroIndex);
      const fill = t.querySelector('i');
      if (fill && n === heroIndex) {
        fill.style.animation = 'none';
        void fill.offsetWidth;
        fill.style.animation = '';
      }
    });
  }

  function stopHero() {
    if (heroTimer) clearInterval(heroTimer);
    heroTimer = null;
  }
  function startHero() {
    stopHero();
    if (reduceMotion) return;
    heroTimer = setInterval(() => goToSlide(heroIndex + 1), HERO_DURATION);
  }

  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      goToSlide(Number(t.dataset.tab));
      startHero();
    });
  });

  if (slides.length && heroEl) {
    goToSlide(0);
    startHero();
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stopHero() : startHero();
    });
  }

  // --- challenges drag slider ------------------------------------------
  const slider = document.getElementById('challengeSlider');
  const sBar = document.getElementById('challengeBar');
  if (slider) {
    const track = slider.querySelector<HTMLElement>('.challenge-slider__track')!;
    let maxX = 0;
    let x = 0;
    let down = false;
    let startX = 0;
    let startPos = 0;

    // Mirrors --bp-tab in 2-design-tokens/breakpoints.css: below it the track
    // scrolls natively and the drag maths is bypassed. Keep the two in step.
    const mqNative = window.matchMedia('(max-width: 900px)');
    const nativeMode = () => mqNative.matches;
    const sign = () => (document.documentElement.dir === 'rtl' ? 1 : -1);

    function measure() {
      maxX = Math.max(0, track.scrollWidth - slider!.clientWidth);
      setX(Math.min(x, maxX));
      syncBtns();
    }

    function setX(v: number) {
      if (nativeMode()) return;
      x = Math.max(0, Math.min(maxX, v));
      track.style.transform = `translate3d(${sign() * x}px,0,0)`;
      if (sBar) {
        const ratio = maxX > 0 ? x / maxX : 0;
        const thumb = sBar.querySelector<HTMLElement>('i')!;
        const visible = slider!.clientWidth / track.scrollWidth;
        thumb.style.width = `${visible * 100}%`;
        thumb.style.transform = `translateX(${(-sign() * ratio * (100 / visible - 100))}%)`;
      }
    }

    slider.addEventListener('pointerdown', (e) => {
      if (nativeMode()) return;
      down = true;
      startX = e.clientX;
      startPos = x;
      slider.classList.add('is-dragging');
      slider.setPointerCapture(e.pointerId);
    });
    slider.addEventListener('pointermove', (e) => {
      if (!down) return;
      setX(startPos - (e.clientX - startX));
    });
    ['pointerup', 'pointercancel'].forEach((ev) => {
      slider.addEventListener(ev, () => {
        down = false;
        slider.classList.remove('is-dragging');
        syncBtns();
      });
    });
    slider.addEventListener('dragstart', (e) => e.preventDefault());

    const nav = document.getElementById('challengeNav');
    const btns = nav ? Array.from(nav.querySelectorAll<HTMLButtonElement>('.slider-nav__btn')) : [];

    function step() {
      const card = track.querySelector<HTMLElement>('.challenge-slide');
      if (!card) return 320;
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 20;
      return card.getBoundingClientRect().width + gap;
    }
    function syncBtns() {
      btns.forEach((b) => {
        b.disabled = b.dataset.dir === 'prev' ? x <= 1 : x >= maxX - 1;
      });
    }
    btns.forEach((b) => {
      b.addEventListener('click', () => {
        setX(x + (b.dataset.dir === 'next' ? step() : -step()));
        syncBtns();
      });
    });

    slider.addEventListener(
      'wheel',
      (e) => {
        if (nativeMode()) return;
        const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.shiftKey ? e.deltaY : 0;
        if (!d) return;
        e.preventDefault();
        setX(x + d);
        syncBtns();
      },
      { passive: false },
    );

    slider.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      const fwd = rtl ? 'ArrowLeft' : 'ArrowRight';
      const bwd = rtl ? 'ArrowRight' : 'ArrowLeft';
      if (e.key === fwd) {
        e.preventDefault();
        setX(x + step());
        syncBtns();
      } else if (e.key === bwd) {
        e.preventDefault();
        setX(x - step());
        syncBtns();
      } else if (e.key === 'Home') {
        e.preventDefault();
        setX(0);
        syncBtns();
      } else if (e.key === 'End') {
        e.preventDefault();
        setX(maxX);
        syncBtns();
      }
    });

    window.addEventListener('resize', measure);
    if (document.fonts?.ready) document.fonts.ready.then(measure);
    measure();
  }

  // --- partner marquee: clone the track for a seamless loop -------------
  const pTrack = document.getElementById('partnersTrack');
  if (pTrack && !pTrack.dataset.cloned) {
    pTrack.innerHTML += pTrack.innerHTML;
    const kids = Array.from(pTrack.children);
    kids.slice(kids.length / 2).forEach((el) => {
      el.setAttribute('aria-hidden', 'true');
      el.setAttribute('tabindex', '-1');
    });
    pTrack.dataset.cloned = '1';
  }
</script>
