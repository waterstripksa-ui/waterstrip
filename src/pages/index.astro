---
// Markup is waterstrip/index.html verbatim; only the copy, imagery and links are
// swapped for CMS content (editable at /admin/home). An image slot with no upload
// shows its placeholder artwork (src/lib/home-assets.ts). Behaviour (hero
// autoplay, challenges slider, partner marquee, reveals) is the vendored main.js.
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/content/cache.ts';
import { challengeImages, discoverTileImages, heroSlideImages, partnerLogos } from '../lib/home-assets.ts';
import { MEMBERSHIP_BANNER_IMG, imageFor, resolveImage } from '../lib/media-assets.ts';

const hero = getSingleton('home_hero');
const discover = getSingleton('home_discover');
const challenges = getSingleton('home_challenges');
const awards = getSingleton('home_awards');
const partners = getSingleton('home_partners');
const aboutBanner = getSingleton('home_about_banner');

/** The panel's 01, 02, … ordinal — derived from position, never stored. */
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title="الرئيسية">
  <section class="hero" id="hero">
    <div class="hero__stage">
      {hero.panels.map((panel, i) => (
        <div class:list={['hero__slide', i === 0 && 'is-active']} data-slide={i}>
          <img alt="" {...resolveImage(panel.imageId, imageFor(heroSlideImages, panel.id))} />
        </div>
      ))}
      <div class="hero__scrim"></div>
      <div class="wrap hero__copy">
        {hero.panels.map((panel, i) => (
          <div class:list={['hero__panel', i === 0 && 'is-active']} data-panel={i}>
            <p class="eyebrow eyebrow--light">{panel.eyebrowAr}</p>
            {i === 0 ? <h1 class="h-display">{panel.headingAr}</h1> : <h2 class="h-display">{panel.headingAr}</h2>}
            <div class="hero__actions">
              <a class="cta-circle cta-circle--light" href={panel.ctaHref}>
                <span>{panel.ctaLabelAr}</span>
                <span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__tabs">
      <div class="wrap">
        {hero.panels.map((panel, i) => (
          <button class:list={['hero-tab', i === 0 && 'is-active']} data-tab={i} type="button"><span>{panel.eyebrowAr}</span><i></i></button>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon ribbon--grey discover">
    <div class="wrap">
      <div class="discover__intro reveal">
        <p class="eyebrow">{discover.eyebrowAr}</p>
        <h2 class="h-intro">{discover.headingAr}</h2>
      </div>
      <div class="card-row bleed reveal" style="margin-top:66px">
        {discover.tiles.map((tile) => (
          <a class="tile" href={tile.href}>
            <img alt="" {...resolveImage(tile.imageId, imageFor(discoverTileImages, tile.id))} />
            <div class="tile__txt">
              <p class="eyebrow eyebrow--light">{tile.eyebrowAr}</p>
              <h3>{tile.headingAr}</h3>
            </div>
            <span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ribbon believe challenges" id="challenges">
    <div class="wrap">
      <div class="believe__intro reveal">
        <p class="eyebrow">{challenges.eyebrowAr}</p>
        <h2 class="h-intro">{challenges.headingAr}</h2>
        <div class="slider-nav" id="believeNav">
          <button aria-label="السابق" class="slider-nav__btn" data-dir="prev" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M19 12H6M13 6l-6 6 6 6"></path></svg></button>
          <button aria-label="التالي" class="slider-nav__btn" data-dir="next" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
        </div>
      </div>
      <div class="slider bleed reveal" id="believeSlider" role="group" style="margin-top:64px" tabindex="0">
        <div class="slider__track">
          {challenges.items.map((c) => (
            <article class="slide">
              <figure><img alt={c.labelAr} {...resolveImage(c.imageId, imageFor(challengeImages, c.id))} /></figure>
              <h4>{c.labelAr}</h4>
            </article>
          ))}
        </div>
      </div>
      <div class="scrollbar" id="believeBar"><i></i></div>
    </div>
  </section>

  {!awards.hidden && (
    <section class="ribbon awards" id="awards">
      <div class="wrap">
        <div class="awards__panel reveal">
          <div class="awards__head">
            <p class="eyebrow eyebrow--light">{awards.eyebrowAr}</p>
            <h2 class="h-section">{awards.headingAr}</h2>
            <p class="lede">{awards.ledeAr}</p>
            <a class="btn-brand" href={awards.ctaHref}>
              <span>{awards.ctaLabelAr}</span>
              <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <ol class="awards__cats">
            {awards.items.map((a, i) => (
              <li class="award">
                <span aria-hidden="true" class="award__no">{ordinal(i)}</span>
                <h3>{a.titleAr}</h3>
                <p>{a.bodyAr}</p>
                <i class="award__rule"></i>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <Fragment slot="after-main">
    <section aria-label={partners.labelAr} class="partners">
      <div class="wrap">
        <p class="partners__label">{partners.labelAr}</p>
        <div class="partners__viewport">
          <div class="partners__track">
            {/* Not lazy (unlike the mockup): the marquee moves logos into view by
                transform, which does not reliably trigger lazy loading. */}
            {partners.items.map((partner) => (
              <a class="partner" href={partner.href} title={partner.nameAr}><img alt={partner.nameAr} {...resolveImage(partner.logoId, imageFor(partnerLogos, partner.id))} /></a>
            ))}
          </div>
        </div>
        <p class="partners__note">{partners.noteAr}</p>
      </div>
    </section>

    <section class="about-banner">
      <img alt="" loading="lazy" {...resolveImage(aboutBanner.imageId, MEMBERSHIP_BANNER_IMG)} />
      <div class="about-banner__in">
        <p class="eyebrow eyebrow--light">{aboutBanner.eyebrowAr}</p>
        <h2>{aboutBanner.headingAr}</h2>
        <p class="about-banner__lede">{aboutBanner.ledeAr}</p>
        <a class="btn-brand" href={aboutBanner.ctaHref}>
          <span>{aboutBanner.ctaLabelAr}</span>
          <svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </section>
  </Fragment>
</Layout>
