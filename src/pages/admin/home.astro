---
// The index page's editable surfaces. Each panel is a React island that PUTs to
// /admin/api/content/<key>; reads go through the content cache, as they must.
// Image fields upload to /admin/api/media and put the returned id in the draft.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMedia, getSingleton, type MediaView } from '../../lib/content/cache.ts';
import { collectMediaIds } from '../../lib/content/schemas/fields.ts';
import { singletons, type SingletonKey } from '../../lib/content/schemas/index.ts';
import HeroEditor from '../../components/admin/HeroEditor.tsx';
import DiscoverEditor from '../../components/admin/DiscoverEditor.tsx';
import ChallengesEditor from '../../components/admin/ChallengesEditor.tsx';
import AwardsEditor from '../../components/admin/AwardsEditor.tsx';
import MapEditor from '../../components/admin/MapEditor.tsx';
import PartnersEditor from '../../components/admin/PartnersEditor.tsx';
import AboutBannerEditor from '../../components/admin/AboutBannerEditor.tsx';

// The cache deep-freezes what it returns, and React needs to build new objects
// from these, so each island gets a structural clone as its initial draft.
const hero = structuredClone(getSingleton('home_hero'));
const discover = structuredClone(getSingleton('home_discover'));
const challenges = structuredClone(getSingleton('home_challenges'));
const awards = structuredClone(getSingleton('home_awards'));
const map = structuredClone(getSingleton('home_map'));
const partners = structuredClone(getSingleton('home_partners'));
const aboutBanner = structuredClone(getSingleton('home_about_banner'));

// Previews for every image the saved content already references. One map is
// shared by all six islands; it is a handful of small records.
const media: Record<string, MediaView> = {};
const surfaces: Array<[SingletonKey, unknown]> = [
  ['home_hero', hero],
  ['home_discover', discover],
  ['home_challenges', challenges],
  ['home_partners', partners],
  ['home_about_banner', aboutBanner],
];
for (const [key, data] of surfaces) {
  for (const ref of collectMediaIds(singletons[key].schema, data)) {
    const view = getMedia(ref.id);
    if (view) media[ref.id] = { ...view };
  }
}
---

<AdminLayout
  title="الصفحة الرئيسية"
  lede="تحرير نصوص الصفحة الرئيسية وصورها. كل قسم يُحفظ على حدة، ويظهر التغيير في الموقع مباشرة بعد الحفظ."
>
  <HeroEditor initial={hero} media={media} client:load />
  <DiscoverEditor initial={discover} media={media} client:load />
  <ChallengesEditor initial={challenges} media={media} client:load />
  <AwardsEditor initial={awards} client:load />
  <MapEditor initial={map} client:load />
  <PartnersEditor initial={partners} media={media} client:load />
  <AboutBannerEditor initial={aboutBanner} media={media} client:load />
</AdminLayout>
