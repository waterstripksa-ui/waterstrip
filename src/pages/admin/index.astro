---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Access is enforced in src/middleware.ts; a user is guaranteed here.
const user = Astro.locals.user!;

const roleLabels: Record<string, string> = {
  admin: 'مدير',
  user: 'عضو',
};
---

<AdminLayout title="نظرة عامة" lede="إدارة محتوى موقع شريط شراكات الابتكار المائي.">
  <div class="panel">
    <h2 class="panel__title">الحساب</h2>
    <dl class="panel__facts">
      <dt class="panel__term">الاسم</dt>
      <dd class="panel__detail">{user.name}</dd>

      <dt class="panel__term">البريد الإلكتروني</dt>
      <dd class="panel__detail panel__detail--ltr">{user.email}</dd>

      <dt class="panel__term">الصلاحية</dt>
      <dd class="panel__detail">{roleLabels[user.role ?? ''] ?? user.role}</dd>
    </dl>
  </div>

  <div class="panel">
    <h2 class="panel__title">المحتوى</h2>
    <dl class="panel__facts">
      <dt class="panel__term">الصفحة الرئيسية</dt>
      <dd class="panel__detail"><a href="/admin/home">تحرير نصوص الصفحة الرئيسية</a></dd>

      <dt class="panel__term">صفحة عن الشريط</dt>
      <dd class="panel__detail"><a href="/admin/about">تحرير نصوص صفحة عن الشريط</a></dd>

      <dt class="panel__term">صفحة تواصل معنا</dt>
      <dd class="panel__detail"><a href="/admin/contact">تحرير نصوص صفحة تواصل معنا</a></dd>
    </dl>
    <p class="form__hint">
      تُضاف بقيّة الصفحات إلى هذه القائمة كلما اكتمل نقلها من التصميم المرجعي.
    </p>
  </div>
</AdminLayout>
