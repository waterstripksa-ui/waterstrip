---
// Ported from waterstrip/forgot-password.html. Pairs with login.astro and
// reuses its .login-card component. No CMS surface: like login itself, this
// is a fixed auth utility form, not editable content. The mockup never wires
// this form to anything (main.js's generic form handler lists interestForm/
// contactForm/loginForm only, not resetForm) and there is no password-reset
// flow in Better Auth yet, so this ports the same "front-end validation +
// confirmation message, no backend" behaviour as contact.astro/
// register-interest.astro use for their still-unwired forms.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="استعادة كلمة المرور" description="استعادة كلمة المرور — شريط شراكات الابتكار المائي.">
  <PageHero
    plain
    title="استعادة كلمة المرور"
    lede="أدخل بريدك الإلكتروني المسجّل، وسنرسل لك رابطًا لإعادة تعيين كلمة المرور."
    crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'تسجيل الدخول', href: '/login' },
      { label: 'استعادة كلمة المرور' },
    ]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="login-card">
        <form class="form login-card__form" id="reset-form" novalidate>
          <div class="form__field">
            <label class="form__label" for="email">البريد الإلكتروني</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
            />
          </div>

          <div class="form__actions">
            <button class="button button--solid button--block" type="submit">
              <span>إرسال الرابط</span>
              <svg
                class="button__icon button__icon--directional"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                height="16"
                width="16"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </button>
            <span class="form__status" id="reset-form-status" hidden>
              <svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              <span>إن كان البريد مسجّلًا لدينا، فستصلك رسالة خلال دقائق.</span>
            </span>
          </div>
        </form>

        <p class="login-card__note">
          <a href="/login">العودة إلى تسجيل الدخول</a>
          <span> · </span>
          <a href="/contact">تواصل مع الأمانة</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const status = document.getElementById('reset-form-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((field) => {
      const bad = !field.value.trim();
      field.style.borderColor = bad ? '#C0392B' : '';
      if (bad) ok = false;
    });
    if (!ok) return;
    status?.removeAttribute('hidden');
    form.querySelector('button[type="submit"]')?.setAttribute('disabled', '');
  });

  form?.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    target.style.borderColor = '';
  });
</script>
