---
// Markup is waterstrip/forgot-password.html verbatim. There is no reset flow
// yet (no Better Auth password reset wired, and the mockup never handles
// #resetForm either), so the inline script only validates and shows the
// mockup's own #rMsg confirmation instead of letting the form reload the page.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';

const banner = getSingleton('legal_banner');
---

<Layout title="استعادة كلمة المرور" description="استعادة كلمة المرور — شريط شراكات الابتكار المائي.">
  <PageHero
    variant="slim"
    title="استعادة كلمة المرور"
    lede="أدخل بريدك الإلكتروني المسجّل، وسنرسل لك رابطًا لإعادة تعيين كلمة المرور."
    crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'تسجيل الدخول', href: '/login' },
      { label: 'استعادة كلمة المرور', span: true },
    ]}
  />

  <section class="ribbon">
    <div class="wrap">
      <div class="auth-card reveal">
        <form class="form" id="resetForm" novalidate>
          <div class="field">
            <label for="r-email">البريد الإلكتروني</label>
            <input autocomplete="email" id="r-email" name="email" required type="email" />
          </div>
          <div class="form-actions">
            <button class="btn-solid" type="submit"><span>إرسال الرابط</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
            <span class="form-msg" id="rMsg"><svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg><span>إن كان البريد مسجّلًا لدينا، فستصلك رسالة خلال دقائق.</span></span>
          </div>
        </form>
        <p class="auth-alt"><a href="/login">العودة إلى تسجيل الدخول</a><span>·</span><a href="/contact">تواصل مع الأمانة</a></p>
      </div>
    </div>
  </section>

  <MembershipBanner slot="after-main" banner={banner} />
</Layout>

<script>
  const form = document.getElementById('resetForm') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('#r-email');
    const bad = !email?.value.trim();
    if (email) email.style.borderColor = bad ? '#C0392B' : '';
    if (bad) return;
    document.getElementById('rMsg')?.classList.add('is-on');
    form.querySelector('.btn-solid')?.setAttribute('disabled', '');
  });
  form?.addEventListener('input', (e) => {
    (e.target as HTMLElement).style.borderColor = '';
  });
</script>
