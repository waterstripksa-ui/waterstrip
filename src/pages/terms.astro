---
// Ported from waterstrip/terms.html. Sections are admin-managed at
// /admin/legal — see src/lib/content/schemas/legal-shared.ts for why this
// page (and cookies/privacy/accessibility) is the one deliberate exception
// to "admins edit content, never structure".
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import LegalProse from '../components/LegalProse.astro';
import MembershipBanner from '../components/MembershipBanner.astro';
import { getSingleton } from '../lib/content/cache.ts';

const page = getSingleton('legal_terms');
const banner = getSingleton('legal_banner');
---

<Layout title={page.titleAr}>
  <PageHero
    title={page.titleAr}
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: page.titleAr }]}
  />

  <LegalProse page={page} />

  <MembershipBanner banner={banner} />
</Layout>
